{
  "name": "@reeval/harness-opencode",
  "version": "0.2.11",
  "private": true,
  "description": "An AI SDK harness adapter for OpenCode 2 on any provider whose key a gateway can broker, over its ACP server (opencode acp)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/opencode-providers.d.ts",
      "default": "./dist/opencode-providers.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ai",
    "harness",
    "opencode",
    "acp"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings test/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.156",
    "@ai-sdk/harness-acp": "1.0.95",
    "@ai-sdk/provider": "4.0.30",
    "@ai-sdk/provider-utils": "5.0.63",
    "zod": "4.6.7"
  }
}
