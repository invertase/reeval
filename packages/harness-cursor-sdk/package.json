{
  "name": "@reeval/harness-cursor-sdk",
  "version": "0.1.9",
  "private": true,
  "description": "An AI SDK harness adapter for Cursor's agent, over the Cursor TypeScript SDK's local runtime",
  "license": "Apache-2.0",
  "author": "Invertase <oss@invertase.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reeval-ai/reeval.git",
    "directory": "packages/harness-cursor-sdk"
  },
  "homepage": "https://github.com/reeval-ai/reeval/tree/main/packages/harness-cursor-sdk#readme",
  "bugs": {
    "url": "https://github.com/reeval-ai/reeval/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ai",
    "harness",
    "cursor",
    "cursor-sdk"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings test/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.172",
    "@ai-sdk/provider": "4.0.35",
    "@ai-sdk/provider-utils": "5.0.73",
    "zod": "4.6.7"
  }
}
