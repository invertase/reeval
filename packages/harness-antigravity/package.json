{
  "name": "@reeval/harness-antigravity",
  "version": "0.1.16",
  "private": true,
  "description": "An AI SDK harness adapter for the Google Antigravity CLI (agy), over its stream-json headless mode",
  "license": "Apache-2.0",
  "author": "Invertase <oss@invertase.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reeval-ai/reeval.git",
    "directory": "packages/harness-antigravity"
  },
  "homepage": "https://github.com/reeval-ai/reeval/tree/main/packages/harness-antigravity#readme",
  "bugs": {
    "url": "https://github.com/reeval-ai/reeval/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ai",
    "harness",
    "antigravity",
    "agy",
    "gemini"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings test/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.181",
    "@ai-sdk/provider": "4.0.37",
    "@ai-sdk/provider-utils": "5.0.79",
    "zod": "4.6.7"
  }
}
