{
  "name": "@reeval/harness-goose",
  "version": "0.1.15",
  "private": true,
  "description": "An AI SDK harness adapter for Goose on a provider's API key, a gateway or Vertex AI, over its ACP server (goose acp)",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ai",
    "harness",
    "goose",
    "acp",
    "gemini"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings test/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.172",
    "@ai-sdk/harness-acp": "1.0.112",
    "@ai-sdk/provider": "4.0.35",
    "@ai-sdk/provider-utils": "5.0.73",
    "zod": "4.6.7"
  }
}
