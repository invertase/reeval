{
  "name": "@reeval/agents",
  "version": "0.1.0",
  "private": true,
  "description": "Run coding-agent harnesses on any runner and track what they did",
  "license": "Apache-2.0",
  "author": "Invertase <oss@invertase.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reeval-ai/reeval.git",
    "directory": "packages/agents"
  },
  "homepage": "https://github.com/reeval-ai/reeval/tree/main/packages/agents#readme",
  "bugs": {
    "url": "https://github.com/reeval-ai/reeval/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./docker": {
      "types": "./dist/docker/index.d.ts",
      "default": "./dist/docker/index.js"
    },
    "./layouts": {
      "types": "./dist/catalog/skill-dirs.d.ts",
      "default": "./dist/catalog/skill-dirs.js"
    },
    "./usage": {
      "types": "./dist/usage.d.ts",
      "default": "./dist/usage.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings test/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.172",
    "@ai-sdk/harness-claude-code": "1.0.176",
    "@reeval/harness-antigravity": "workspace:0.1.17",
    "@reeval/harness-codex": "workspace:0.1.14",
    "@reeval/harness-cursor-sdk": "workspace:0.1.9",
    "@reeval/harness-fx": "workspace:0.1.14",
    "@reeval/harness-goose": "workspace:0.1.17",
    "@reeval/harness-grok-build": "workspace:0.1.13",
    "@reeval/harness-opencode": "workspace:0.2.16",
    "@reeval/harness-pi": "workspace:0.2.10",
    "@reeval/sandbox-docker": "workspace:*"
  },
  "devDependencies": {
    "oxc-parser": "0.156.0"
  }
}
