{
  "name": "@reeval/sandbox-docker",
  "version": "0.1.0",
  "private": true,
  "description": "A local Docker sandbox for AI SDK harnesses, with credential brokering and egress control",
  "license": "Apache-2.0",
  "author": "Invertase <oss@invertase.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invertase/reeval.git",
    "directory": "packages/sandbox-docker"
  },
  "homepage": "https://github.com/invertase/reeval/tree/main/packages/sandbox-docker#readme",
  "bugs": {
    "url": "https://github.com/invertase/reeval/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "default": "./dist/process.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docker",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings test/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.156",
    "@ai-sdk/harness-claude-code": "1.0.160",
    "@reeval/harness-antigravity": "workspace:0.1.12",
    "@reeval/harness-codex": "workspace:0.1.8",
    "@reeval/harness-cursor-sdk": "workspace:0.1.6",
    "@reeval/harness-fx": "workspace:0.1.1",
    "@reeval/harness-goose": "workspace:0.1.5",
    "@reeval/harness-grok-build": "workspace:0.1.4",
    "@reeval/harness-opencode": "workspace:0.2.10",
    "@reeval/harness-pi": "workspace:0.2.8",
    "ws": "8.22.0",
    "zod": "4.6.7"
  }
}
