{
  "name": "@reeval/sandbox-docker",
  "version": "0.1.0",
  "private": true,
  "description": "A local Docker sandbox for AI SDK harnesses, with credential brokering and egress control",
  "license": "Apache-2.0",
  "author": "Invertase <oss@invertase.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reeval-ai/reeval.git",
    "directory": "packages/sandbox-docker"
  },
  "homepage": "https://github.com/reeval-ai/reeval/tree/main/packages/sandbox-docker#readme",
  "bugs": {
    "url": "https://github.com/reeval-ai/reeval/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "default": "./dist/process.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docker",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings test/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.172",
    "@balena/dockerignore": "1.0.2",
    "ws": "8.22.1",
    "zod": "4.6.7"
  }
}
