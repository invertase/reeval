{
  "name": "@evalsuite/sandbox-docker",
  "version": "0.1.0",
  "private": true,
  "description": "A local Docker sandbox for AI SDK harnesses, with credential brokering and egress control",
  "license": "Apache-2.0",
  "author": "Invertase <oss@invertase.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invertase/evalsuite.git",
    "directory": "packages/sandbox-docker"
  },
  "homepage": "https://github.com/invertase/evalsuite/tree/main/packages/sandbox-docker#readme",
  "bugs": {
    "url": "https://github.com/invertase/evalsuite/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./process": {
      "types": "./dist/process.d.ts",
      "default": "./dist/process.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docker"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings test/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.124",
    "@ai-sdk/harness-claude-code": "1.0.128",
    "@evalsuite/harness-antigravity": "workspace:0.1.0",
    "@evalsuite/harness-codex": "workspace:0.1.0",
    "@evalsuite/harness-cursor-sdk": "workspace:0.1.0",
    "@evalsuite/harness-goose": "workspace:0.1.0",
    "@evalsuite/harness-opencode": "workspace:0.2.0",
    "@evalsuite/harness-pi": "workspace:0.1.0",
    "ws": "8.21.0",
    "zod": "4.6.5"
  }
}
