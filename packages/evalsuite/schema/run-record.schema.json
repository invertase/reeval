{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from RunRecord in src/history/types.ts by `pnpm schema:update`; don't edit. A run record: evals/.history/<run>.json and .es/runs/<run>.json.",
  "title": "RunRecord",
  "$ref": "#/$defs/RunRecord",
  "$defs": {
    "ArtifactLevel": {
      "enum": [
        "all",
        "failures",
        "none"
      ]
    },
    "AttemptError": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ErrorKind"
        },
        "message": {
          "type": "string"
        },
        "prepare": {
          "$ref": "#/$defs/PrepareFailureRecord"
        }
      },
      "required": [
        "kind",
        "message"
      ]
    },
    "AttemptFiles": {
      "type": "object",
      "properties": {
        "diff": {
          "$ref": "#/$defs/FileRef"
        },
        "judgeInput": {
          "$ref": "#/$defs/FileRef"
        },
        "rawTranscript": {
          "$ref": "#/$defs/FileRef"
        },
        "setupLog": {
          "$ref": "#/$defs/FileRef"
        },
        "transcript": {
          "$ref": "#/$defs/FileRef"
        }
      },
      "required": []
    },
    "AttemptRecord": {
      "type": "object",
      "properties": {
        "activity": {
          "type": "object",
          "properties": {
            "fileEdits": {
              "type": "number"
            },
            "reasoningMs": {
              "type": "number"
            },
            "tools": {
              "type": "number"
            },
            "webFetches": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "webSearches": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "required": [
            "fileEdits",
            "reasoningMs",
            "tools",
            "webFetches",
            "webSearches"
          ]
        },
        "cell": {
          "type": "string"
        },
        "changedFiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "count": {
                "type": "number"
              },
              "path": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "added",
                  "deleted",
                  "modified"
                ]
              }
            },
            "required": [
              "path",
              "status"
            ]
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              },
              "durationMs": {
                "type": "number"
              },
              "exitCode": {
                "type": "number"
              },
              "log": {
                "$ref": "#/$defs/FileRef"
              }
            },
            "required": [
              "command",
              "durationMs",
              "exitCode"
            ]
          }
        },
        "context": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextFile"
          }
        },
        "durationMs": {
          "type": "number"
        },
        "egress": {
          "anyOf": [
            {
              "$ref": "#/$defs/EgressRecord"
            },
            {
              "type": "null"
            }
          ]
        },
        "env": {
          "type": "object",
          "properties": {
            "brokered": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "secrets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "vars": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "brokered",
            "secrets",
            "vars"
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptError"
            },
            {
              "type": "null"
            }
          ]
        },
        "files": {
          "$ref": "#/$defs/AttemptFiles"
        },
        "id": {
          "type": "string"
        },
        "imageId": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "judgements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JudgementRecord"
          }
        },
        "key": {
          "type": "string"
        },
        "n": {
          "type": "number"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "seq": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        },
        "servedModels": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "startedAt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "timings": {
          "$ref": "#/$defs/PhaseTimings"
        },
        "turns": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "durationMs": {
                "type": "number"
              },
              "error": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "model": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "prompt": {
                "type": "string"
              },
              "startedAt": {
                "type": "string"
              },
              "status": {
                "$ref": "#/$defs/TurnStatus"
              },
              "text": {
                "type": "string"
              },
              "unreported": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/WebEventType"
                }
              },
              "usage": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/TokenUsage"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "durationMs",
              "error",
              "model",
              "prompt",
              "startedAt",
              "status",
              "text",
              "unreported",
              "usage"
            ]
          }
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/TokenUsage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "activity",
        "cell",
        "changedFiles",
        "checks",
        "context",
        "durationMs",
        "egress",
        "env",
        "error",
        "files",
        "id",
        "imageId",
        "judgements",
        "key",
        "n",
        "outcome",
        "seq",
        "servedModels",
        "startedAt",
        "timings",
        "turns",
        "usage"
      ]
    },
    "CellGate": {
      "anyOf": [
        {
          "enum": [
            "all",
            "none"
          ]
        },
        {
          "type": "object",
          "properties": {
            "passRate": {
              "type": "number"
            }
          },
          "required": [
            "passRate"
          ]
        }
      ]
    },
    "CellRecord": {
      "type": "object",
      "properties": {
        "environment": {
          "type": "string"
        },
        "environmentDigest": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "fail": {
          "type": "number"
        },
        "fingerprint": {
          "type": "string"
        },
        "fingerprintParts": {
          "$ref": "#/$defs/FingerprintParts"
        },
        "gate": {
          "$ref": "#/$defs/CellGate"
        },
        "harness": {
          "type": "string"
        },
        "harnessKind": {
          "type": "string"
        },
        "infraError": {
          "type": "number"
        },
        "key": {
          "type": "string"
        },
        "lift": {
          "$ref": "#/$defs/Lift"
        },
        "model": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pass": {
          "type": "number"
        },
        "passRate": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        },
        "role": {
          "$ref": "#/$defs/CellRole"
        },
        "runs": {
          "type": "number"
        },
        "sandbox": {
          "type": "string"
        },
        "skipped": {
          "type": "number"
        },
        "variant": {
          "type": "string"
        }
      },
      "required": [
        "environment",
        "environmentDigest",
        "fail",
        "fingerprint",
        "fingerprintParts",
        "gate",
        "harness",
        "harnessKind",
        "infraError",
        "key",
        "model",
        "outcome",
        "overrides",
        "pass",
        "passRate",
        "role",
        "runs",
        "sandbox",
        "skipped"
      ]
    },
    "CellRole": {
      "enum": [
        "control",
        "variant"
      ]
    },
    "ContextFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "Cost": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        },
        "outputTokens": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        },
        "source": {
          "enum": [
            "reported",
            "unreported"
          ]
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/TokenUsage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "inputTokens",
        "outputTokens",
        "source",
        "usage"
      ]
    },
    "EgressPolicy": {
      "anyOf": [
        {
          "enum": [
            "allow-all",
            "deny-all"
          ]
        },
        {
          "type": "object",
          "properties": {
            "allow": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "allow"
          ]
        }
      ]
    },
    "EgressRecord": {
      "type": "object",
      "properties": {
        "allowed": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "blocked": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "connections": {
                "type": "number"
              },
              "host": {
                "type": "string"
              },
              "port": {
                "type": "number"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "connections",
              "host",
              "port",
              "reason"
            ]
          }
        },
        "contacted": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "connections": {
                "type": "number"
              },
              "host": {
                "type": "string"
              },
              "port": {
                "type": "number"
              },
              "received": {
                "type": "number"
              },
              "sent": {
                "type": "number"
              }
            },
            "required": [
              "connections",
              "host",
              "port",
              "received",
              "sent"
            ]
          }
        },
        "expectedBlocked": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "connections": {
                "type": "number"
              },
              "host": {
                "type": "string"
              },
              "port": {
                "type": "number"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "connections",
              "host",
              "port",
              "reason"
            ]
          }
        },
        "policy": {
          "$ref": "#/$defs/EgressPolicy"
        },
        "recorded": {
          "type": "boolean"
        }
      },
      "required": [
        "allowed",
        "blocked",
        "contacted",
        "expectedBlocked",
        "policy",
        "recorded"
      ]
    },
    "EnvironmentRecord": {
      "type": "object",
      "properties": {
        "brokered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "digest": {
          "type": "string"
        },
        "egress": {
          "$ref": "#/$defs/EgressPolicy"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          }
        },
        "mcp": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parent": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "secrets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "setup": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "commit": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "excluded": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "name": {
                "type": "string"
              },
              "placement": {
                "$ref": "#/$defs/SkillPlacement"
              },
              "sha256": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            },
            "required": [
              "commit",
              "excluded",
              "name",
              "placement",
              "sha256",
              "source"
            ]
          }
        },
        "unset": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vars": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "brokered",
        "digest",
        "egress",
        "files",
        "mcp",
        "name",
        "overrides",
        "parent",
        "secrets",
        "setup",
        "skills",
        "unset",
        "vars"
      ]
    },
    "ErrorKind": {
      "enum": [
        "aborted",
        "assertion",
        "infra",
        "judge",
        "timeout"
      ]
    },
    "EvalEntry": {
      "type": "object",
      "properties": {
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AttemptRecord"
          }
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CellRecord"
          }
        },
        "file": {
          "type": "string"
        },
        "fingerprint": {
          "type": "string"
        },
        "group": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/Outcome"
        },
        "passRate": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        },
        "slug": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "todo": {
          "type": "boolean"
        }
      },
      "required": [
        "attempts",
        "cells",
        "file",
        "fingerprint",
        "group",
        "id",
        "key",
        "name",
        "outcome",
        "passRate",
        "slug",
        "sources",
        "tags",
        "todo"
      ]
    },
    "FileRef": {
      "type": "object",
      "properties": {
        "bytes": {
          "type": "number"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "bytes",
        "path",
        "sha256"
      ]
    },
    "FingerprintParts": {
      "type": "object",
      "properties": {
        "agentCli": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "context": {
          "type": "string"
        },
        "environment": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "harness": {
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "judge": {
          "type": "string"
        },
        "sources": {
          "type": "string"
        }
      },
      "required": [
        "agentCli",
        "context",
        "environment",
        "harness",
        "image",
        "judge",
        "sources"
      ]
    },
    "GitInfo": {
      "type": "object",
      "properties": {
        "branch": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "commitTime": {
          "type": "string"
        },
        "diffHash": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "dirty": {
          "type": "boolean"
        },
        "remote": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "sha": {
          "type": "string"
        },
        "shallow": {
          "type": "boolean"
