    "JudgementRecord": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "resolvedModel": {
          "type": "string"
        },
        "retries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JudgeRetry"
          }
        },
