        "model",
        "question",
        "score",
        "threshold",
        "verdict"
      ]
    },
    "JudgeRetry": {
      "type": "object",
      "properties": {
        "delayMs": {
          "type": "number"
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "delayMs",
        "error"
      ]
    },
    "Lift": {
      "type": "object",
      "properties": {
        "control": {
          "type": "object",
          "properties": {
            "counted": {
              "type": "number"
            },
            "pass": {
              "type": "number"
            }
          },
          "required": [
            "counted",
            "pass"
          ]
        },
        "interval": {
          "type": "object",
          "properties": {
            "hi": {
              "type": "number"
