{
  "name": "@invertase/foobar",
  "version": "0.0.1",
  "description": "ES (Eval Suite): an eval runner for coding agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invertase/evalsuite.git",
    "directory": "packages/evalsuite"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "es": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "default": "./dist/harness.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox.d.ts",
      "default": "./dist/sandbox.js"
    },
    "./judge": {
      "types": "./dist/judge.d.ts",
      "default": "./dist/judge.js"
    },
    "./view": {
      "types": "./dist/view/index.d.ts",
      "default": "./dist/view/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/vendor.mjs && node scripts/copy-studio-app.mjs",
    "features:matrix": "node --experimental-strip-types --no-warnings --import ./test/support/tables-only.mjs test/support/feature-matrix.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-timeout=600000 --experimental-strip-types --no-warnings test/*.test.ts",
    "test:plan": "node --test --experimental-strip-types --no-warnings test/plan.test.ts",
    "test:features": "node --test --experimental-strip-types --no-warnings test/features.test.ts",
    "test:docker": "ES_FIXTURE_TIERS=docker ES_TEST_REQUIRE_DOCKER=1 node --test --experimental-strip-types --no-warnings test/features.test.ts test/docker.test.ts test/docker-antigravity.test.ts",
    "test:real": "ES_FIXTURE_TIERS=real ES_TEST_REAL=1 node --test --experimental-strip-types --no-warnings test/features.test.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.79",
    "@ai-sdk/harness": "1.0.124",
    "@ai-sdk/harness-claude-code": "1.0.128",
    "@ai-sdk/provider-utils": "5.0.47",
    "@ai-sdk/typesafe-ai": "3.0.6",
    "@hono/node-server": "2.1.1",
    "ai": "7.0.114",
    "hono": "4.13.9",
    "jiti": "2.7.0",
    "std-env": "4.2.0",
    "vitest": "5.0.2",
    "ws": "8.21.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@evalsuite/harness-antigravity": "workspace:0.1.0",
    "@evalsuite/harness-cursor-sdk": "workspace:0.1.0",
    "@evalsuite/sandbox-docker": "workspace:*",
    "studio-web": "workspace:*"
  }
}
