{
  "name": "@reeval/harness-pi",
  "version": "0.2.9",
  "private": true,
  "description": "An AI SDK harness adapter for pi on its providers' API keys or a gateway, running pi --mode json in the sandbox",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./providers": {
      "types": "./dist/pi-providers.d.ts",
      "default": "./dist/pi-providers.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets"
  ],
  "keywords": [
    "ai",
    "harness",
    "pi",
    "gemini"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings test/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.181",
    "@ai-sdk/provider": "4.0.37",
    "@ai-sdk/provider-utils": "5.0.79",
    "zod": "4.6.7"
  }
}
