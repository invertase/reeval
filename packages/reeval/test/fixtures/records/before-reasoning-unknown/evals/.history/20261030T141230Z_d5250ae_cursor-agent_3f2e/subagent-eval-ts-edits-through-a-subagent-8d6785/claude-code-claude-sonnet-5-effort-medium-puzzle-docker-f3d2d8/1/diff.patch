new file mode 100644
index 0000000..8d8a113
--- /dev/null
+++ b/src/NOTES.md
@@ -0,0 +1 @@
+`src/schedule.js` greedily selects the maximum number of non-overlapping meetings from a list of `[start, end)` half-open intervals by sorting on end time and picking each meeting whose start is at or after the previously selected meeting's end.
diff --git a/src/schedule.js b/src/schedule.js
index fe8c91e..54e5901 100644
--- a/src/schedule.js
+++ b/src/schedule.js
@@ -1,4 +1,13 @@
 // Returns the number of meetings that can be attended without overlap.
 export function maxMeetings(meetings) {
-  return 0
+  const sorted = [...meetings].sort((a, b) => a[1] - b[1])
+  let count = 0
+  let lastEnd = -Infinity
+  for (const [start, end] of sorted) {
+    if (start >= lastEnd) {
+      count++
+      lastEnd = end
+    }
+  }
+  return count
 }
