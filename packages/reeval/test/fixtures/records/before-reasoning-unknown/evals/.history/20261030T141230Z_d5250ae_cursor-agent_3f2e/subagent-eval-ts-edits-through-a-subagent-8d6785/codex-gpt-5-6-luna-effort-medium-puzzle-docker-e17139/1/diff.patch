+Meetings are selected greedily by earliest finishing time, allowing adjacent meetings.
diff --git a/src/schedule.js b/src/schedule.js
index fe8c91e..53f7098 100644
--- a/src/schedule.js
+++ b/src/schedule.js
@@ -1,4 +1,16 @@
 // Returns the number of meetings that can be attended without overlap.
 export function maxMeetings(meetings) {
-  return 0
+  let lastEnd = -Infinity
+  let attended = 0
+
+  const byEndTime = [...meetings].sort((first, second) => first[1] - second[1])
+
+  for (const [start, end] of byEndTime) {
+    if (start >= lastEnd) {
+      attended += 1
+      lastEnd = end
+    }
+  }
+
+  return attended
 }
