+# Notes
+
+Picking the meeting that ends earliest at each step is correct because it leaves the most remaining time for future meetings, so it can never do worse than any other valid choice.
diff --git a/src/schedule.js b/src/schedule.js
index fe8c91e..54e5901 100644
--- a/src/schedule.js
+++ b/src/schedule.js
@@ -1,4 +1,13 @@
 // Returns the number of meetings that can be attended without overlap.
 export function maxMeetings(meetings) {
-  return 0
+  const sorted = [...meetings].sort((a, b) => a[1] - b[1])
+  let count = 0
+  let lastEnd = -Infinity
+  for (const [start, end] of sorted) {
+    if (start >= lastEnd) {
+      count++
+      lastEnd = end
+    }
+  }
+  return count
 }
