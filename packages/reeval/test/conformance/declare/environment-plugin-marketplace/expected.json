                  {
                    "kind": "plugin",
                    "source": "marketplace",
                    "name": "format",
                    "marketplace": {
                      "source": "npm",
                      "spec": "@acme/plugins@2.0.0"
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      "children": [
        {
          "type": "eval",
          "name": "entries read at the attempt",
          "mode": "run",
          "options": {},
          "body": "b1"
        }
      ]
    }
  ]
}
