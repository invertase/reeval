{
  "children": [
    {
      "type": "group",
      "name": "marketplace plugins",
      "mode": "run",
      "options": {
        "environment": {
          "kind": "environment",
          "name": "listed",
          "layers": [
            {
              "name": "listed",
              "spec": {
                "plugins": [
                  {
                    "kind": "plugin",
                    "source": "marketplace",
                    "name": "lint",
                    "marketplace": {
                      "source": "git",
                      "repo": "github:acme/agent-plugins",
                      "ref": "v3"
                    },
                    "only": ["skills"]
