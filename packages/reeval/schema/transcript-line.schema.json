{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from TranscriptLine in src/view/model.ts by `pnpm schema:update`; don't edit. One line of an attempt's transcript.jsonl in a run's artifacts.",
  "title": "TranscriptLine",
  "$ref": "#/$defs/TranscriptLine",
  "$defs": {
    "TokenUsage": {
      "description": "The tokens one turn used, as its harness reported them. `input` excludes cache reads and writes (so the prompt was `input + cacheRead + cacheWrite`); `reasoning` is part of `output`.",
      "type": "object",
      "properties": {
        "cacheRead": {
          "type": "number"
        },
        "cacheWrite": {
          "type": "number"
        },
        "input": {
          "type": "number"
        },
        "output": {
          "type": "number"
        },
        "reasoning": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        }
      },
      "required": ["cacheRead", "cacheWrite", "input", "output", "reasoning"]
    },
    "TranscriptLine": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "added": {
              "description": "Line counts, or null when the harness didn't send the content (e.g. deletes).",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "atMs": {
              "type": "number"
            },
            "durationInferred": {
              "description": "Set when the harness never reported the call's end, so `durationMs` runs to the next event's `atMs` (the turn's end for the last).",
              "const": true
            },
            "durationMs": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "kind": {
              "description": "`write` is a whole-file write whose result doesn't say whether the file existed before (Antigravity's, fx's, Goose's, Grok Build's and pi's write tools, for example).",
              "enum": ["create", "delete", "modify", "write"]
            },
            "path": {
              "type": "string"
            },
            "removed": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "stalled": {
              "description": "True when a shell-like tool or edit ran at least two minutes.",
              "type": "boolean"
            },
            "subagent": {
              "description": "The `toolCallId` of the subagent call whose agent made this call; absent for the agent's own.",
              "type": "string"
            },
            "toolCallId": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "turn": {
              "type": "number"
            },
            "type": {
              "const": "file-edit"
            }
          },
          "required": [
            "added",
            "atMs",
            "durationMs",
            "kind",
            "path",
            "removed",
            "toolCallId",
            "ts",
            "turn",
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "durationInferred": {
              "description": "Set when the harness never reported the call's end, so `durationMs` runs to the next event's `atMs` (the turn's end for the last).",
              "const": true
            },
            "durationMs": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "input": {},
            "ok": {
              "description": "Whether the call succeeded; null when the harness never reported its result.",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {},
            "stalled": {
              "description": "True when a shell-like tool or edit ran at least two minutes.",
              "type": "boolean"
            },
            "subagent": {
              "description": "The `toolCallId` of the subagent call whose agent made this call; absent for the agent's own.",
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "toolCallId": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "turn": {
              "type": "number"
            },
            "type": {
              "const": "tool"
            }
          },
          "required": [
            "atMs",
            "durationMs",
            "input",
            "ok",
            "output",
            "tool",
            "toolCallId",
            "ts",
            "turn",
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "durationInferred": {
              "description": "Set when the harness never reported the call's end, so `durationMs` runs to the next event's `atMs` (the turn's end for the last).",
              "const": true
            },
            "durationMs": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "ok": {
              "description": "Whether the fetch succeeded; null when the harness never reported its result.",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "stalled": {
              "description": "True when a shell-like tool or edit ran at least two minutes.",
              "type": "boolean"
            },
            "subagent": {
              "description": "The `toolCallId` of the subagent call whose agent made this call; absent for the agent's own.",
              "type": "string"
            },
            "toolCallId": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "turn": {
              "type": "number"
            },
            "type": {
              "const": "web-fetch"
            },
            "url": {
              "type": "string"
            }
          },
          "required": ["atMs", "durationMs", "ok", "toolCallId", "ts", "turn", "type", "url"]
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "durationInferred": {
              "description": "Set when the harness never reported the call's end, so `durationMs` runs to the next event's `atMs` (the turn's end for the last).",
              "const": true
            },
            "durationMs": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "ok": {
              "description": "Whether the search succeeded. Absent means it did; null means the harness never reported its result.",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "query": {
              "type": "string"
            },
            "references": {
              "description": "How many sources the harness says it used; Cursor sends no URLs or titles.",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "stalled": {
              "description": "True when a shell-like tool or edit ran at least two minutes.",
              "type": "boolean"
            },
            "subagent": {
              "description": "The `toolCallId` of the subagent call whose agent made this call; absent for the agent's own.",
              "type": "string"
            },
            "toolCallId": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "turn": {
              "type": "number"
            },
            "type": {
              "const": "web-search"
            }
          },
          "required": [
            "atMs",
            "durationMs",
            "query",
            "references",
            "toolCallId",
            "ts",
            "turn",
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "durationMs": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "text": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "turn": {
              "type": "number"
            },
            "type": {
              "enum": ["reasoning", "text"]
            }
          },
          "required": ["atMs", "durationMs", "text", "ts", "turn", "type"]
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "durationMs": {
              "type": "number"
            },
            "firstByteMs": {
              "description": "Milliseconds from the call's start to its response body's first byte; null when none came.",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "model": {
              "description": "The model that served it, from its request or response; null when neither named one.",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string"
                }
              ]
            },
            "request": {
              "description": "`POST api.anthropic.com/v1/messages`: the method, host and path.",
              "type": "string"
            },
            "role": {
              "description": "`main` for one of the agent's own steps, `side` for a call its CLI made around them: a session title, a web search's own model call, Antigravity's Flash Lite calls. A call is `main` when its tokens are one of the turn's steps' as the harness reported them. Otherwise it's `side` when its request declared at most one tool while another call in the attempt declared more, or when another model served it than served the turn's other calls, and `main` when neither holds. Absent in records from before roles.",
              "enum": ["main", "side"]
            },
            "status": {
              "description": "The response's HTTP status; null when none came.",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "stream": {
              "description": "Set on a call that carries the whole turn (Cursor's), so it isn't counted as model time.",
              "const": true
            },
            "ts": {
              "type": "string"
            },
            "turn": {
              "type": "number"
            },
            "type": {
              "const": "model-call"
            },
            "usage": {
              "description": "The tokens its response body named; null when it named none (Cursor's are protobuf).",
              "anyOf": [
                {
                  "$ref": "#/$defs/TokenUsage"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "atMs",
            "durationMs",
            "firstByteMs",
            "model",
            "request",
            "status",
            "ts",
            "turn",
            "type",
            "usage"
          ]
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "durationMs": {
              "type": "number"
            },
            "status": {
              "$ref": "#/$defs/TurnStatus"
            },
            "ts": {
              "type": "string"
            },
            "turn": {
              "type": "number"
            },
            "type": {
              "const": "turn-end"
            }
          },
          "required": ["atMs", "durationMs", "status", "ts", "turn", "type"]
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "message": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "turn": {
              "type": "number"
            },
            "type": {
              "const": "error"
            }
          },
          "required": ["atMs", "message", "ts", "turn", "type"]
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "message": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "turn": {
              "type": "number"
            },
            "type": {
              "const": "retry"
            }
          },
          "required": ["atMs", "message", "ts", "turn", "type"]
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "text": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "turn": {
              "type": "number"
            },
            "type": {
              "const": "prompt"
            }
          },
          "required": ["atMs", "text", "ts", "turn", "type"]
        }
      ]
    },
    "TurnStatus": {
      "enum": ["aborted", "completed", "error"]
    }
  }
}
