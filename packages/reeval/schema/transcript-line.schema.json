{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from TranscriptLine in src/view/model.ts by `pnpm schema:update`; don't edit. One line of an attempt's transcript.jsonl in a run's artifacts.",
  "title": "TranscriptLine",
  "$ref": "#/$defs/TranscriptLine",
  "$defs": {
    "TranscriptLine": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "added": {
              "description": "Line counts, or null when the harness didn't send the content (e.g. deletes).",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "atMs": {
              "type": "number"
            },
            "durationMs": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "kind": {
              "description": "`write` is a whole-file write whose result doesn't say whether the file existed before (Antigravity's, fx's, Goose's, Grok Build's and pi's write tools, for example).",
              "enum": ["create", "delete", "modify", "write"]
            },
            "path": {
              "type": "string"
            },
            "removed": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "stalled": {
              "description": "True when a shell-like tool or edit ran at least two minutes.",
              "type": "boolean"
            },
            "subagent": {
              "description": "The `toolCallId` of the subagent call whose agent made this call; absent for the agent's own.",
              "type": "string"
            },
            "toolCallId": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "turn": {
              "type": "number"
            },
            "type": {
              "const": "file-edit"
            }
          },
          "required": [
            "added",
            "atMs",
            "durationMs",
            "kind",
            "path",
            "removed",
            "toolCallId",
            "ts",
            "turn",
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "durationMs": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "input": {},
            "ok": {
              "description": "Whether the call succeeded; null when the harness never reported its result.",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "output": {},
            "stalled": {
              "description": "True when a shell-like tool or edit ran at least two minutes.",
              "type": "boolean"
            },
            "subagent": {
              "description": "The `toolCallId` of the subagent call whose agent made this call; absent for the agent's own.",
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "toolCallId": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "turn": {
              "type": "number"
            },
            "type": {
              "const": "tool"
            }
          },
          "required": [
            "atMs",
            "durationMs",
            "input",
            "ok",
            "output",
            "tool",
            "toolCallId",
            "ts",
            "turn",
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "durationMs": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "ok": {
              "description": "Whether the fetch succeeded; null when the harness never reported its result.",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "stalled": {
              "description": "True when a shell-like tool or edit ran at least two minutes.",
              "type": "boolean"
            },
            "subagent": {
              "description": "The `toolCallId` of the subagent call whose agent made this call; absent for the agent's own.",
              "type": "string"
            },
            "toolCallId": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "turn": {
              "type": "number"
            },
            "type": {
              "const": "web-fetch"
            },
            "url": {
              "type": "string"
            }
          },
          "required": ["atMs", "durationMs", "ok", "toolCallId", "ts", "turn", "type", "url"]
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "durationMs": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "ok": {
              "description": "Whether the search succeeded. Absent means it did; null means the harness never reported its result.",
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "query": {
              "type": "string"
            },
            "references": {
              "description": "How many sources the harness says it used; Cursor sends no URLs or titles.",
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "stalled": {
              "description": "True when a shell-like tool or edit ran at least two minutes.",
              "type": "boolean"
            },
            "subagent": {
              "description": "The `toolCallId` of the subagent call whose agent made this call; absent for the agent's own.",
              "type": "string"
            },
            "toolCallId": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "turn": {
              "type": "number"
            },
            "type": {
              "const": "web-search"
            }
          },
          "required": [
            "atMs",
            "durationMs",
            "query",
            "references",
            "toolCallId",
            "ts",
            "turn",
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "durationMs": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "text": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "turn": {
              "type": "number"
            },
            "type": {
              "enum": ["reasoning", "text"]
            }
          },
          "required": ["atMs", "durationMs", "text", "ts", "turn", "type"]
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "durationMs": {
              "type": "number"
            },
            "status": {
              "$ref": "#/$defs/TurnStatus"
            },
            "ts": {
              "type": "string"
            },
            "turn": {
              "type": "number"
            },
            "type": {
              "const": "turn-end"
            }
          },
          "required": ["atMs", "durationMs", "status", "ts", "turn", "type"]
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "message": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "turn": {
              "type": "number"
            },
            "type": {
              "const": "error"
            }
          },
          "required": ["atMs", "message", "ts", "turn", "type"]
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "message": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "turn": {
              "type": "number"
            },
            "type": {
              "const": "retry"
            }
          },
          "required": ["atMs", "message", "ts", "turn", "type"]
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "text": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "turn": {
              "type": "number"
            },
            "type": {
              "const": "prompt"
            }
          },
          "required": ["atMs", "text", "ts", "turn", "type"]
        }
      ]
    },
    "TurnStatus": {
      "enum": ["aborted", "completed", "error"]
    }
  }
}
