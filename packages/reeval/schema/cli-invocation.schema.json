{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from CliInvocation in src/report/types.ts by `pnpm schema:update`; don't edit. One line of .reeval/cli.jsonl, the last reeval commands reeval report reads.",
  "title": "CliInvocation",
  "$ref": "#/$defs/CliInvocation",
  "$defs": {
    "CliInvocation": {
      "description": "One `reeval` command, as the CLI logs it when it ends: redacted and path-scrubbed on disk too.",
      "type": "object",
      "properties": {
        "argv": {
          "description": "The arguments after `reeval`, with every flag value and argument replaced by `<value>` or `<arg>`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "at": {
          "type": "string"
        },
        "command": {
          "description": "`run`, `studio build`, …; null when the command line didn't parse.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "durationMs": {
          "type": "number"
        },
        "error": {
          "description": "What ended the command with an error: a usage error, one reeval expects, or a crash.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": ["crash", "expected", "usage"]
                },
                "message": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "stack": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string"
                    }
                  ]
                }
              },
              "required": ["kind", "message", "name", "stack"]
            }
          ]
        },
        "exitCode": {
          "type": "number"
        },
        "reeval": {
          "type": "string"
        },
        "runId": {
          "description": "The run `reeval run` wrote, when it got that far.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "unhandledErrors": {
          "description": "Errors the run reported that no eval owned.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "argv",
        "at",
        "command",
        "durationMs",
        "error",
        "exitCode",
        "reeval",
        "runId",
        "unhandledErrors"
      ]
    }
  }
}
