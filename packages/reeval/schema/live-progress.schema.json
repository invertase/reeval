{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from LiveProgress in src/view/live.ts by `pnpm schema:update`; don't edit. A running reeval run's progress: .reeval/staging/<run>/live.json, read by reeval studio.",
  "title": "LiveProgress",
  "$ref": "#/$defs/LiveProgress",
  "$defs": {
    "LiveAttempt": {
      "type": "object",
      "properties": {
        "cell": {
          "description": "The cell key, e.g. `fake/default/fake`.",
          "type": "string"
        },
        "durationMs": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number"
            }
          ]
        },
        "evalId": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "key": {
          "description": "The attempt key, `<eval id> # <cell key>#<n>`, as in the record.",
          "type": "string"
        },
        "n": {
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "startedAt": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "status": {
          "$ref": "#/$defs/LiveStatus"
        }
      },
      "required": [
        "cell",
        "durationMs",
        "evalId",
        "file",
        "key",
        "n",
        "name",
        "startedAt",
        "status"
      ]
    },
    "LiveCounts": {
      "description": "Attempts finished, and of those how many passed, failed or errored; and how many are running.",
      "type": "object",
      "properties": {
        "done": {
          "type": "number"
        },
        "errored": {
          "type": "number"
        },
        "failed": {
          "type": "number"
        },
        "passed": {
          "type": "number"
        },
        "running": {
          "type": "number"
        },
        "skipped": {
          "type": "number"
        }
      },
      "required": ["done", "errored", "failed", "passed", "running", "skipped"]
    },
    "LivePhase": {
      "description": "What the run is doing: running attempts, canceling them, or assembling its record.",
      "enum": ["cancelling", "finishing", "running"]
    },
    "LiveProgress": {
      "type": "object",
      "properties": {
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LiveAttempt"
          }
        },
        "counts": {
          "$ref": "#/$defs/LiveCounts"
        },
        "heartbeatAt": {
          "description": "Rewritten every few seconds while the run is alive.",
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "invocation": {
          "description": "How the run was started, for a `--resume` after a quit that wrote no record.",
          "$ref": "#/$defs/RunInvocation"
        },
        "phase": {
          "$ref": "#/$defs/LivePhase"
        },
        "pid": {
          "description": "The `reeval run` process and the host it runs on, so a killed run can be told apart.",
          "type": "number"
        },
        "planned": {
          "type": "number"
        },
        "runId": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "startedAt": {
          "type": "string"
        }
      },
      "required": [
        "attempts",
        "counts",
        "heartbeatAt",
        "host",
        "phase",
        "pid",
        "planned",
        "runId",
        "schemaVersion",
        "startedAt"
      ]
    },
    "LiveStatus": {
      "description": "Where an attempt is: waiting, running, or finished with its outcome.",
      "enum": ["fail", "infra_error", "pass", "queued", "running", "skipped"]
    },
    "RunInvocation": {
      "description": "The `reeval run` settings that shaped a run's plan, as it was first started. A resume keeps them, so it finishes the attempts the run planned.",
      "type": "object",
      "properties": {
        "concurrency": {
          "description": "`--concurrency` or `REEVAL_CONCURRENCY`; unset when the config or the machine sized it.",
          "type": "number"
        },
        "filters": {
          "description": "The filter arguments.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "profile": {
          "description": "The profile the run was sized with; unset when it had none.",
          "type": "string"
        },
        "runs": {
          "description": "`--runs`; unset when each cell ran its own `runs`.",
          "type": "number"
        },
        "tags": {
          "description": "`--tag`, without the profile's own tags.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["filters", "tags"]
    }
  },
  "x-schemaVersion": 1
}
