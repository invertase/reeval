{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from AttemptReply in src/contract/attempt.ts by `pnpm schema:update`; don't edit. reeval's reply to an attempt request.",
  "title": "AttemptReply",
  "$ref": "#/$defs/AttemptReply",
  "$defs": {
    "AssertionRecord": {
      "description": "One `expect` or `expect.require` matcher call an attempt made, or a check another language made.",
      "type": "object",
      "properties": {
        "at": {
          "description": "`path:line` of the call in the eval file, relative to the project root, when reeval saw it.",
          "type": "string"
        },
        "durationMs": {
          "description": "Async matchers only (`toHaveFile`, `toSucceed`, `.resolves`, `expect.poll`).",
          "type": "number"
        },
        "label": {
          "description": "`label` is the supplied `expect` label. Without one, it is the matcher plus its first argument or named subject, cut at 60 characters. Repeats get ` #2`, ` #3`, and later suffixes.",
          "type": "string"
        },
        "labelled": {
          "description": "The eval gave the label.",
          "type": "boolean"
        },
        "matcher": {
          "description": "`toHaveFile`, `not.toBe`, `resolves.toBe`, `poll.toBe`.",
          "type": "string"
        },
        "message": {
          "description": "Why it failed or couldn't answer, or why `expect.skip` marked it not applicable, cut at 1 KB.",
          "type": "string"
        },
        "preSatisfied": {
          "description": "A passing `toHaveFile` / `not.toHaveFile` the agent didn't satisfy (path already matched, or was absent before and after). Optional on older records.",
          "type": "boolean"
        },
        "reason": {
          "description": "Why the check does not apply (`expect.skip`'s second argument).",
          "type": "string"
        },
        "soft": {
          "description": "A failure didn't end the eval's body: an `expect`. False for `expect.require` and for a check that threw, such as Python's `assert`, which end the body when they fail. True for `expect.skip`.",
          "type": "boolean"
        },
        "status": {
          "description": "`error`: the matcher couldn't answer (a subject it can't read, an event the harness doesn't report). `not_applicable`: `expect.skip` (or a language runner's equivalent); never fails the attempt and leaves the check's pass/fail denominator.",
          "type": "string",
          "enum": ["pass", "fail", "error", "not_applicable"]
        },
        "target": {
          "description": "File matcher target: `toHaveFile`'s path, or `path <pattern>` when a pattern was given. Optional on older records and non-file matchers.",
          "type": "string"
        }
      },
      "required": ["label", "labelled", "matcher", "soft", "status"],
      "additionalProperties": false
    },
    "AttemptError": {
      "description": "Why a call failed, in reeval's words.",
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "name": {
          "description": "The error's class, e.g. `UsageError` or `AssertionError`.",
          "type": "string"
        }
      },
      "required": ["message", "name"],
      "additionalProperties": {}
    },
    "AttemptReply": {
      "description": "reeval's reply to a call: its result, or the error it threw. A failed matcher is a result (its record says `fail`), not an error, unless the matcher couldn't run.",
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "description": "Pairs a reply with its request.",
                  "type": "string",
                  "pattern": "\\S"
                },
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "op": {
                  "type": "string",
                  "const": "send"
                },
                "turn": {
                  "$ref": "#/$defs/TurnData"
                }
              },
              "required": ["id", "ok", "op", "turn"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "description": "Pairs a reply with its request.",
                  "type": "string",
                  "pattern": "\\S"
                },
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "op": {
                  "type": "string",
                  "const": "exec"
                },
                "result": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/ExecResult"
                    },
                    {
                      "description": "A background process, still running.",
                      "type": "object",
                      "properties": {
                        "handle": {
                          "description": "A background process, as an exec or serve reply named it.",
                          "type": "string",
                          "pattern": "\\S"
                        }
                      },
                      "required": ["handle"],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": ["id", "ok", "op", "result"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "handle": {
                  "description": "A background process, as an exec or serve reply named it.",
                  "type": "string",
                  "pattern": "\\S"
                },
                "id": {
                  "description": "Pairs a reply with its request.",
                  "type": "string",
                  "pattern": "\\S"
                },
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "op": {
                  "type": "string",
                  "const": "serve"
                },
                "port": {
                  "description": "The container port it listens on.",
                  "type": "number"
                }
              },
              "required": ["handle", "id", "ok", "op", "port"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "description": "Pairs a reply with its request.",
                  "type": "string",
                  "pattern": "\\S"
                },
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "op": {
                  "type": "string",
                  "const": "kill"
                }
              },
              "required": ["id", "ok", "op"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "capture": {
                  "$ref": "#/$defs/Capture"
                },
                "id": {
                  "description": "Pairs a reply with its request.",
                  "type": "string",
                  "pattern": "\\S"
                },
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "op": {
                  "type": "string",
                  "const": "capture"
                }
              },
              "required": ["capture", "id", "ok", "op"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "contents": {
                  "description": "Null when there is no such file.",
                  "type": ["string", "null"]
                },
                "id": {
                  "description": "Pairs a reply with its request.",
                  "type": "string",
                  "pattern": "\\S"
                },
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "op": {
                  "type": "string",
                  "const": "readFile"
                }
              },
              "required": ["contents", "id", "ok", "op"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "description": "Pairs a reply with its request.",
                  "type": "string",
                  "pattern": "\\S"
                },
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "op": {
                  "type": "string",
                  "const": "writeFile"
                }
              },
              "required": ["id", "ok", "op"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "description": "Pairs a reply with its request.",
                  "type": "string",
                  "pattern": "\\S"
                },
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "op": {
                  "type": "string",
                  "const": "observe"
                }
              },
              "required": ["id", "ok", "op"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "assertion": {
                  "$ref": "#/$defs/AssertionRecord"
                },
                "id": {
                  "description": "Pairs a reply with its request.",
                  "type": "string",
                  "pattern": "\\S"
                },
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "op": {
                  "type": "string",
                  "const": "expect"
                }
              },
              "required": ["assertion", "id", "ok", "op"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "assertion": {
                  "$ref": "#/$defs/AssertionRecord"
                },
                "id": {
                  "description": "Pairs a reply with its request.",
                  "type": "string",
                  "pattern": "\\S"
                },
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "op": {
                  "type": "string",
                  "const": "record"
                }
              },
              "required": ["assertion", "id", "ok", "op"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "description": "Pairs a reply with its request.",
                  "type": "string",
                  "pattern": "\\S"
                },
                "ok": {
                  "type": "boolean",
                  "const": true
                },
                "op": {
                  "type": "string",
                  "const": "judge"
                },
                "verdict": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/Verdict"
                    },
                    {
                      "$ref": "#/$defs/JudgeFailure"
                    }
                  ]
                }
              },
              "required": ["id", "ok", "op", "verdict"],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "description": "Pairs a reply with its request.",
              "type": "string",
              "pattern": "\\S"
            },
            "ok": {
              "type": "boolean",
              "const": true
            },
            "op": {
              "type": "string",
              "const": "expect"
            },
            "untested": {
              "description": "The strings the matcher tested that a `{ matchedBy, answers }` argument has no answer for, by its `matchedBy`. Nothing was recorded: answer them and make the call again.",
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "required": ["id", "ok", "op", "untested"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "error": {
              "$ref": "#/$defs/AttemptError"
            },
            "id": {
              "description": "Pairs a reply with its request.",
              "type": "string",
              "pattern": "\\S"
            },
            "ok": {
              "type": "boolean",
              "const": false
            },
            "op": {
              "type": "string",
              "enum": [
                "send",
                "exec",
                "readFile",
                "writeFile",
                "observe",
                "expect",
                "record",
                "judge",
                "serve",
                "kill",
                "capture"
              ]
            }
          },
          "required": ["error", "id", "ok", "op"],
          "additionalProperties": false
        }
      ]
    },
    "Capture": {
      "description": "What `c.capture()` returns: the PNG is also in the attempt record under `artifacts/`, and the page facts in `artifacts/<name>.capture.json` beside it.",
      "type": "object",
      "properties": {
        "console": {
          "description": "Each message the console showed, in order; at most 100 of each level.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "level": {
                "type": "string",
                "enum": ["error", "warning", "info", "log", "debug"]
              },
              "source": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            },
            "required": ["level", "source", "text"],
            "additionalProperties": false
          }
        },
        "dropped": {
          "description": "How many messages, errors and requests the caps left out; absent when none.",
          "type": "number"
        },
        "errors": {
          "description": "The page errors: each uncaught exception and unhandled promise rejection, with its stack, at most 100.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "failedRequests": {
          "description": "Requests that failed or answered 400 or above, in order, at most 100.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "error": {
                "type": "string"
              },
              "method": {
                "type": "string"
              },
              "status": {
                "type": "number"
              },
              "url": {
                "type": "string"
              }
            },
            "required": ["method", "url"],
            "additionalProperties": false
          }
        },
        "file": {
          "description": "`artifacts/<name>.png` under the attempt directory.",
          "type": "object",
          "properties": {
            "bytes": {
              "type": "number"
            },
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          },
          "required": ["bytes", "path", "sha256"],
          "additionalProperties": false
        },
        "finalUrl": {
          "description": "Where the page ended up, after redirects and client-side routing: a path on the app.",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "description": "Path on the app, as passed in.",
          "type": "string"
        },
        "port": {
          "description": "Container port that was tunneled.",
          "type": "number"
        },
        "status": {
          "description": "The HTTP status of the main frame's latest document, after redirects. A full navigation replaces it; a client-side route change keeps it. Absent when no response came.",
          "type": "number"
        },
        "viewport": {
          "description": "What the author asked, including `'full-page'`.",
          "anyOf": [
            {
              "$ref": "#/$defs/CaptureWindow"
            },
            {
              "type": "string",
              "const": "full-page"
            }
          ]
        }
      },
      "required": [
        "console",
        "errors",
        "failedRequests",
        "file",
        "finalUrl",
        "name",
        "path",
        "port",
        "viewport"
      ],
      "additionalProperties": false
    },
    "CaptureWindow": {
      "description": "Live tab size for `c.capture()`. Default 1280×720 when the call and cascade omit `viewport`.",
      "type": "object",
      "properties": {
        "height": {
          "description": "In CSS pixels.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "width": {
          "description": "In CSS pixels.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": ["height", "width"],
      "additionalProperties": false
    },
    "Diff": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileChange"
          }
        },
        "patch": {
          "type": "string"
        }
      },
      "required": ["files", "patch"],
      "additionalProperties": false
    },
    "ExecResult": {
      "type": "object",
      "properties": {
        "exitCode": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "stderr": {
          "type": "string"
        },
        "stdout": {
          "type": "string"
        }
      },
      "required": ["exitCode", "stderr", "stdout"],
      "additionalProperties": false
    },
    "FileChange": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["added", "modified", "deleted"]
        }
      },
      "required": ["path", "status"],
      "additionalProperties": false
    },
    "JudgeArtifactRef": {
      "description": "A capture this judge call sent as a file part. Bytes live in the `artifacts/<name>.png` file.",
      "type": "object",
      "properties": {
        "bytes": {
          "type": "number"
        },
        "mediaType": {
          "type": "string",
          "const": "image/png"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "description": "The `artifacts/<name>.png` path under the attempt directory.",
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": ["bytes", "mediaType", "name", "path", "sha256"],
      "additionalProperties": false
    },
    "JudgeFailure": {
      "description": "What `c.judge()` returns when the call failed (the provider's error, after any retries): the attempt fails as a judge error once the eval's body has finished, so the judges and checks after it still run.",
      "type": "object",
      "properties": {
        "artifacts": {
          "description": "Captures this call sent the judge as file parts, when any.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/JudgeArtifactRef"
          }
        },
        "error": {
          "type": "string"
        },
        "gateway": {
          "description": "The gateway from the config's `gateway` list the call went through; unset without one.",
          "type": "string",
          "enum": ["direct", "vercel", "openrouter", "vertex"]
        },
        "model": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "score": {
          "type": "null"
        },
        "threshold": {
          "type": "number"
        },
        "verdict": {
          "type": "string",
          "const": "error"
        }
      },
      "required": ["error", "model", "question", "score", "threshold", "verdict"],
      "additionalProperties": false
    },
    "TokenUsage": {
      "description": "The tokens one turn used, as its harness reported them. `input` excludes cache reads and writes (so the prompt was `input + cacheRead + cacheWrite`); `reasoning` is part of `output`.",
      "type": "object",
      "properties": {
        "cacheRead": {
          "type": "number"
        },
        "cacheWrite": {
          "type": "number"
        },
        "input": {
          "type": "number"
        },
        "output": {
          "type": "number"
        },
        "reasoning": {
          "type": ["number", "null"]
        }
      },
      "required": ["cacheRead", "cacheWrite", "input", "output", "reasoning"],
      "additionalProperties": false
    },
    "TranscriptEvent": {
      "description": "Normalized agent events. Each tool call is one event, merged with its result; `durationMs` is wall time until the result arrived (Cursor's own `completed_at_ms` can be earlier). Null when the harness never reported the end. Long shell or edit calls set `stalled: true`. A call the harness never reported a result for (the turn ended or was cut short first) has `ok: null`: it isn't known to have failed, and no failure count includes it.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "durationMs": {
              "type": ["number", "null"]
            },
            "text": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": ["text", "reasoning"]
            }
          },
          "required": ["atMs", "durationMs", "text", "ts", "type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "added": {
              "description": "Line counts, or null when the harness didn't send the content (e.g. deletes).",
              "type": ["number", "null"]
            },
            "atMs": {
              "type": "number"
            },
            "durationInferred": {
              "description": "Set when the harness never reported the call's end, so `durationMs` runs to the next event's `atMs` (the turn's end for the last).",
              "type": "boolean",
              "const": true
            },
            "durationMs": {
              "type": ["number", "null"]
            },
            "kind": {
              "description": "`write` is a whole-file write whose result doesn't say whether the file existed before (Antigravity's, fx's, Goose's, Grok Build's and pi's write tools, for example).",
              "type": "string",
              "enum": ["create", "modify", "write", "delete"]
            },
            "path": {
              "type": "string"
            },
            "removed": {
              "type": ["number", "null"]
            },
            "stalled": {
              "description": "True when a shell-like tool or edit ran at least two minutes.",
              "type": "boolean"
            },
            "subagent": {
              "description": "The `toolCallId` of the subagent call whose agent made this call; absent for the agent's own.",
              "type": "string"
            },
            "toolCallId": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "file-edit"
            }
          },
          "required": [
            "added",
            "atMs",
            "durationMs",
            "kind",
            "path",
            "removed",
            "toolCallId",
            "ts",
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "durationInferred": {
              "description": "Set when the harness never reported the call's end, so `durationMs` runs to the next event's `atMs` (the turn's end for the last).",
              "type": "boolean",
              "const": true
            },
            "durationMs": {
              "type": ["number", "null"]
            },
            "ok": {
              "description": "Whether the search succeeded. Absent means it did; null means the harness never reported its result.",
              "type": ["boolean", "null"]
            },
            "query": {
              "type": "string"
            },
            "references": {
              "description": "How many sources the harness says it used; Cursor sends no URLs or titles.",
              "type": ["number", "null"]
            },
            "stalled": {
              "description": "True when a shell-like tool or edit ran at least two minutes.",
              "type": "boolean"
            },
            "subagent": {
              "description": "The `toolCallId` of the subagent call whose agent made this call; absent for the agent's own.",
              "type": "string"
            },
            "toolCallId": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "web-search"
            }
          },
          "required": ["atMs", "durationMs", "query", "references", "toolCallId", "ts", "type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "durationInferred": {
              "description": "Set when the harness never reported the call's end, so `durationMs` runs to the next event's `atMs` (the turn's end for the last).",
              "type": "boolean",
              "const": true
            },
            "durationMs": {
              "type": ["number", "null"]
            },
            "ok": {
              "description": "Whether the fetch succeeded; null when the harness never reported its result.",
              "type": ["boolean", "null"]
            },
            "stalled": {
              "description": "True when a shell-like tool or edit ran at least two minutes.",
              "type": "boolean"
            },
            "subagent": {
              "description": "The `toolCallId` of the subagent call whose agent made this call; absent for the agent's own.",
              "type": "string"
            },
            "toolCallId": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "web-fetch"
            },
            "url": {
              "type": "string"
            }
          },
          "required": ["atMs", "durationMs", "ok", "toolCallId", "ts", "type", "url"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "durationInferred": {
              "description": "Set when the harness never reported the call's end, so `durationMs` runs to the next event's `atMs` (the turn's end for the last).",
              "type": "boolean",
              "const": true
            },
            "durationMs": {
              "type": ["number", "null"]
            },
            "input": {},
            "ok": {
              "description": "Whether the call succeeded; null when the harness never reported its result.",
              "type": ["boolean", "null"]
            },
            "output": {},
            "outputTruncated": {
              "description": "Set when `output` is only part of the output, with a line where the rest was cut: `transcript.jsonl` keeps the first 96K and last 16K characters of one past 128K (of its JSON, for structured output), and the harness adapter keeps the first and last 512 KiB of a saved output past 1 MiB. `bytes` is the whole output's size in UTF-8.",
              "type": "object",
              "properties": {
                "bytes": {
                  "type": "number"
                }
              },
              "required": ["bytes"],
              "additionalProperties": false
            },
            "outputView": {
              "description": "What `output` holds: `model`, the result as the harness gave it to the model; `full`, the tool's whole output, which can be more than the model saw (the harness cut it for the model, or saved it to a file and gave the model a pointer, which reeval read).",
              "type": "string",
              "enum": ["model", "full"]
            },
            "stalled": {
              "description": "True when a shell-like tool or edit ran at least two minutes.",
              "type": "boolean"
            },
            "subagent": {
              "description": "The `toolCallId` of the subagent call whose agent made this call; absent for the agent's own.",
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "toolCallId": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "tool"
            }
          },
          "required": [
            "atMs",
            "durationMs",
            "input",
            "ok",
            "output",
            "tool",
            "toolCallId",
            "ts",
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "message": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "error"
            }
          },
          "required": ["atMs", "message", "ts", "type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "message": {
              "type": "string"
            },
            "ts": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "retry"
            }
          },
          "required": ["atMs", "message", "ts", "type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "atMs": {
              "type": "number"
            },
            "durationMs": {
              "type": "number"
            },
            "firstByteMs": {
              "description": "Milliseconds from the call's start to its response body's first byte; null when none came.",
              "type": ["number", "null"]
            },
            "model": {
              "description": "The model that served it, from its request or response; null when neither named one.",
              "type": ["string", "null"]
            },
            "request": {
              "description": "`POST api.anthropic.com/v1/messages`: the method, host and path.",
              "type": "string"
            },
            "role": {
              "description": "`main` for one of the agent's own steps, `side` for a call its CLI made around them: a session title, a web search's own model call, Antigravity's Flash Lite calls. A call is `main` when its tokens are one of the turn's steps' as the harness reported them. Otherwise it's `side` when its request declared at most one tool while another call in the attempt declared more, or when another model served it than served the turn's other calls, and `main` when neither holds. Absent in records from before roles.",
              "type": "string",
              "enum": ["main", "side"]
            },
            "status": {
              "description": "The response's HTTP status; null when none came.",
              "type": ["number", "null"]
            },
            "stream": {
              "description": "Set on a call that carries the whole turn (Cursor's), so it isn't counted as model time.",
              "type": "boolean",
              "const": true
            },
            "ts": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "model-call"
            },
            "usage": {
              "description": "The tokens its response body named; null when it named none (Cursor's are protobuf).",
              "anyOf": [
                {
                  "$ref": "#/$defs/TokenUsage"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "atMs",
            "durationMs",
            "firstByteMs",
            "model",
            "request",
            "status",
            "ts",
            "type",
            "usage"
          ],
          "additionalProperties": false
        }
      ]
    },
    "TurnData": {
      "description": "A turn as data, as a record or another language's runner carries it: `Turn` without its methods.",
      "type": "object",
      "properties": {
        "diff": {
          "description": "Workspace changes since the eval started, as of the end of this turn.",
          "$ref": "#/$defs/Diff"
        },
        "durationMs": {
          "type": "number"
        },
        "model": {
          "description": "The model the harness says served the turn, e.g. `composer-2.5[fast=false]`; null when it reports none. It can differ from the requested one (an alias, or parameters it filled in).",
          "type": ["string", "null"]
        },
        "prompt": {
          "type": "string"
        },
        "startedAt": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TurnStatus"
        },
        "text": {
          "description": "The agent's final message for this turn.",
          "type": "string"
        },
        "transcript": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TranscriptEvent"
          }
        },
        "unreported": {
          "description": "Event types the harness couldn't report for this turn: the agent may have searched or fetched with no event in `transcript`. `toHaveSearched()` and `toHaveFetched()` refuse such a turn. Usually `[]`; a Cursor turn whose web calls the adapter couldn't recover (its SDK drops them from the stream) is `['web-search', 'web-fetch']`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/WebEventType"
          }
        },
        "usage": {
          "description": "Tokens the turn used; null when the harness reports none.",
          "anyOf": [
            {
              "$ref": "#/$defs/TokenUsage"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "diff",
        "durationMs",
        "model",
        "prompt",
        "startedAt",
        "status",
        "text",
        "transcript",
        "unreported",
        "usage"
      ],
      "additionalProperties": false
    },
    "TurnStatus": {
      "type": "string",
      "enum": ["completed", "aborted", "error"]
    },
    "Verdict": {
      "type": "object",
      "properties": {
        "artifacts": {
          "description": "Captures this call sent the judge as file parts, when any.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/JudgeArtifactRef"
          }
        },
        "costUsd": {
          "description": "What the gateway says the call cost, in US dollars (OpenRouter's `usage.cost`); unset when it names none.",
          "type": "number"
        },
        "gateway": {
          "description": "The gateway from the config's `gateway` list the call went through; unset without one.",
          "type": "string",
          "enum": ["direct", "vercel", "openrouter", "vertex"]
        },
        "model": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "resolvedModel": {
          "description": "The model id the provider says served the call, when it reports one.",
          "type": "string"
        },
        "score": {
          "description": "The judge's probability that the answer is yes, from 0 to 1.",
          "type": "number"
        },
        "threshold": {
          "type": "number"
        },
        "upstream": {
          "description": "The upstream provider the gateway says served the call (OpenRouter's); unset when it names none.",
          "type": "string"
        },
        "verdict": {
          "type": "string",
          "enum": ["pass", "fail"]
        }
      },
      "required": ["model", "question", "score", "threshold", "verdict"],
      "additionalProperties": false
    },
    "WebEventType": {
      "description": "The transcript events a harness may be unable to report.",
      "type": "string",
      "enum": ["web-search", "web-fetch"]
    }
  }
}
