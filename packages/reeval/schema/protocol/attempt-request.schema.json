{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from AttemptRequest in src/contract/attempt.ts by `pnpm schema:update`; don't edit. A call an eval's body makes on its attempt, as a runner in another language sends it.",
  "title": "AttemptRequest",
  "$ref": "#/$defs/AttemptRequest",
  "$defs": {
    "AnsweredPattern": {
      "description": "A pattern the runner matches in its own language. reeval runs the matcher with it, and when the matcher tests a string not in `answers` replies with those strings (`untested`) instead of a record; the runner matches them and makes the call again with them in `answers`.",
      "type": "object",
      "properties": {
        "answers": {
          "description": "Whether it matches each string the runner has been asked about.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "matchedBy": {
          "description": "The pattern as the runner's language writes it, e.g. `re.compile('npm t')`.",
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": ["answers", "matchedBy"],
      "additionalProperties": false
    },
    "AttemptCall": {
      "description": "One call an eval's body makes on its attempt. The sandbox and the agent session start on the first call that needs them; there's no call to start them.",
      "oneOf": [
        {
          "description": "`c.send(prompt)`: the next turn of the agent session. Replies with a turn.",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "send"
            },
            "prompt": {
              "description": "The turn's prompt.",
              "type": "string"
            }
          },
          "required": ["op", "prompt"],
          "additionalProperties": false
        },
        {
          "description": "`c.exec(command, { background? })`: a command in the sandbox. Replies with its exit code and output, or with a handle when it runs in the background.",
          "type": "object",
          "properties": {
            "background": {
              "description": "Leave it running and reply with its handle, not its output.",
              "type": "boolean"
            },
            "command": {
              "description": "A shell command, run in the workspace.",
              "type": "string",
              "pattern": "\\S"
            },
            "op": {
              "type": "string",
              "const": "exec"
            }
          },
          "required": ["command", "op"],
          "additionalProperties": false
        },
        {
          "description": "`c.serve(command, port?)`: a background process and its port.",
          "type": "object",
          "properties": {
            "command": {
              "description": "A shell command; `PORT` is set to the port.",
              "type": "string",
              "pattern": "\\S"
            },
            "op": {
              "type": "string",
              "const": "serve"
            },
            "port": {
              "description": "The container port. Omit it and reeval allocates one.",
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "required": ["command", "op"],
          "additionalProperties": false
        },
        {
          "description": "`handle.kill()`: stops a background process. Killing one that's gone is fine.",
          "type": "object",
          "properties": {
            "handle": {
              "description": "A background process, as an exec or serve reply named it.",
              "type": "string",
              "pattern": "\\S"
            },
            "op": {
              "type": "string",
              "const": "kill"
            }
          },
          "required": ["handle", "op"],
          "additionalProperties": false
        },
        {
          "description": "`c.capture(target, options)`: screenshots a path on a tunneled sandbox port and writes `artifacts/<name>.png`. Replies with the capture.",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "capture"
            },
            "options": {
              "$ref": "#/$defs/CaptureCallData"
            },
            "target": {
              "description": "A container port, or a serve handle by its id.",
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "port": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    }
                  },
                  "required": ["port"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "handle": {
                      "description": "A background process, as an exec or serve reply named it.",
                      "type": "string",
                      "pattern": "\\S"
                    }
                  },
                  "required": ["handle"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": ["op", "target"],
          "additionalProperties": false
        },
        {
          "description": "`c.readFile(path)`. Replies with its contents, or null when there is no such file.",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "readFile"
            },
            "path": {
              "description": "Workspace-relative, or `~/` for the home directory.",
              "type": "string",
              "pattern": "\\S"
            }
          },
          "required": ["op", "path"],
          "additionalProperties": false
        },
        {
          "description": "`c.writeFile(path, contents)`, creating its directories.",
          "type": "object",
          "properties": {
            "contents": {
              "description": "The file's contents, in `encoding`.",
              "type": "string"
            },
            "encoding": {
              "description": "How `contents` is encoded; base64 carries bytes. Default `utf8`.",
              "type": "string",
              "enum": ["utf8", "base64"]
            },
            "op": {
              "type": "string",
              "const": "writeFile"
            },
            "path": {
              "description": "Workspace-relative, or `~/` for the home directory.",
              "type": "string",
              "pattern": "\\S"
            }
          },
          "required": ["contents", "op", "path"],
          "additionalProperties": false
        },
        {
          "description": "A matcher call: `expect(subject, label).not?.matcher(...args)`. Replies with its record.",
          "type": "object",
          "properties": {
            "args": {
              "description": "The matcher's arguments.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/MatcherArg"
              }
            },
            "label": {
              "description": "`expect`'s second argument.",
              "type": "string"
            },
            "matcher": {
              "description": "The matcher's name, e.g. `toHaveFile` or `toBe`, without `not.`.",
              "type": "string",
              "pattern": "^[a-z][A-Za-z]*$"
            },
            "not": {
              "description": "Called as `expect(…).not`.",
              "type": "boolean"
            },
            "op": {
              "type": "string",
              "const": "expect"
            },
            "poll": {
              "description": "`expect.poll`: reeval re-reads the subject and retries the matcher until it passes, recording only the final outcome. The subject must be one reeval can re-read: the attempt, a command or a file.",
              "type": "object",
              "properties": {
                "interval": {
                  "description": "Milliseconds between tries. Default 50.",
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "timeout": {
                  "description": "Milliseconds before it fails with the last error. Default 1000.",
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            },
            "soft": {
              "description": "Called as `expect.soft`: a failure fails the attempt at its end.",
              "type": "boolean"
            },
            "subject": {
              "$ref": "#/$defs/MatcherSubject"
            }
          },
          "required": ["args", "matcher", "not", "op", "soft", "subject"],
          "additionalProperties": false
        },
        {
          "description": "`c.judge(question, options)`. Replies with its verdict, or a judge failure when the provider failed.",
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "judge"
            },
            "options": {
              "$ref": "#/$defs/JudgeCallData"
            },
            "question": {
              "description": "A yes/no question about the graded turn or value.",
              "type": "string",
              "pattern": "\\S"
            }
          },
          "required": ["op", "question"],
          "additionalProperties": false
        }
      ]
    },
    "AttemptRequest": {
      "description": "A call, numbered so its reply can find it.",
      "type": "object",
      "properties": {
        "call": {
          "$ref": "#/$defs/AttemptCall"
        },
        "id": {
          "description": "Pairs a reply with its request.",
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": ["call", "id"],
      "additionalProperties": false
    },
    "Capture": {
      "description": "What `c.capture()` returns: the PNG is also in the attempt record under `artifacts/`.",
      "type": "object",
      "properties": {
        "file": {
          "description": "`artifacts/<name>.png` under the attempt directory.",
          "type": "object",
          "properties": {
            "bytes": {
              "type": "number"
            },
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string"
            }
          },
          "required": ["bytes", "path", "sha256"],
          "additionalProperties": false
        },
        "name": {
          "type": "string"
        },
        "path": {
          "description": "Path on the app, as passed in.",
          "type": "string"
        },
        "port": {
          "description": "Container port that was tunneled.",
          "type": "number"
        },
        "viewport": {
          "description": "What the author asked, including `'full-page'`.",
          "anyOf": [
            {
              "$ref": "#/$defs/CaptureWindow"
            },
            {
              "type": "string",
              "const": "full-page"
            }
          ]
        }
      },
      "required": ["file", "name", "path", "port", "viewport"],
      "additionalProperties": false
    },
    "CaptureCallData": {
      "description": "`c.capture()`'s camera and path as data. Default `path` is `/`; default `name` is derived from the path. A test's `fakeInstructions` journey is TypeScript-only.",
      "type": "object",
      "properties": {
        "instructions": {
          "description": "Journey: goal strings and `{ wait }` beats, run by the vision model.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/CaptureInstruction"
          }
        },
        "model": {
          "description": "Overrides cascaded `capture.model` for this call.",
          "type": "string"
        },
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "path": {
          "type": "string"
        },
        "timeout": {
          "$ref": "#/$defs/Duration"
        },
        "viewport": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptureWindow"
            },
            {
              "type": "string",
              "const": "full-page"
            }
          ]
        },
        "wait": {
          "description": "Look-ready once, before the first model shot or the saved PNG. Default `'load'`.",
          "$ref": "#/$defs/Wait"
        }
      },
      "additionalProperties": false
    },
    "CaptureInstruction": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "object",
          "properties": {
            "wait": {
              "$ref": "#/$defs/Wait"
            }
          },
          "required": ["wait"],
          "additionalProperties": false
        }
      ]
    },
    "CaptureWait": {
      "description": "Chromium look-ready events. `'load'` is `window` load (`Page.loadEventFired`). `'idle'` is `Page.lifecycleEvent` `networkAlmostIdle`.",
      "type": "string",
      "enum": ["load", "idle"]
    },
    "CaptureWindow": {
      "description": "Live tab size for `c.capture()`. Default 1280×720 when the call and cascade omit `viewport`.",
      "type": "object",
      "properties": {
        "height": {
          "description": "In CSS pixels.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "width": {
          "description": "In CSS pixels.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": ["height", "width"],
      "additionalProperties": false
    },
    "Duration": {
      "description": "More than zero: `90s`, `15m`, `1h`, or a number of milliseconds.",
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "string",
          "pattern": "^(?=.*[1-9])\\d+(\\.\\d+)?(ms|s|m|h)$"
        }
      ]
    },
    "ExecResult": {
      "type": "object",
      "properties": {
        "exitCode": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "stderr": {
          "type": "string"
        },
        "stdout": {
          "type": "string"
        }
      },
      "required": ["exitCode", "stderr", "stdout"],
      "additionalProperties": false
    },
    "FakeJudgeData": {
      "description": "`fakeJudge()` as data: the score every call gets.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "fake-judge"
        },
        "score": {
          "description": "The score (0–1) every call gets.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": ["kind", "score"],
      "additionalProperties": false
    },
    "JSONValue": {
      "description": "Any JSON value.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      ]
    },
    "JudgeCallData": {
      "description": "`c.judge()`'s options as data: the judge options, with the model by name or a fake judge's numeric score, plus the call-only `on` and `artifacts`.",
      "type": "object",
      "properties": {
        "artifacts": {
          "description": "Captures this call sends the judge as image file parts: a capture `c.capture` returned, or its name, or `true` for every capture so far. The provider that cannot take files fails the call.",
          "anyOf": [
            {
              "type": "boolean",
              "const": true
            },
            {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  {
                    "$ref": "#/$defs/Capture"
                  }
                ]
              }
            }
          ]
        },
        "gateway": {
          "description": "The gateway the judge's calls go through, by name or by its helper. It skips the config's `gateway` fallback: the plan refuses a gateway that isn't listed or can't serve the model.",
          "anyOf": [
            {
              "description": "A gateway the config lists by name: `direct` is each provider's own key, as without `gateway`; `vercel` is Vercel AI Gateway.",
              "type": "string",
              "enum": ["direct", "vercel"]
            },
            {
              "description": "One entry of the config's `gateway` list.",
              "oneOf": [
                {
                  "description": "Each provider's own key, as without `gateway`: made by `direct()` in `reeval/gateway`.",
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "direct"
                    }
                  },
                  "required": ["kind"],
                  "additionalProperties": false
                },
                {
                  "description": "Vercel AI Gateway, with `AI_GATEWAY_API_KEY` (else `VERCEL_OIDC_TOKEN`): made by `vercel()` in `reeval/gateway`. It serves Claude Code, Codex, Goose, pi, OpenCode, fx and Grok Build.",
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "vercel"
                    }
                  },
                  "required": ["kind"],
                  "additionalProperties": false
                }
              ]
            }
          ]
        },
        "maxConcurrent": {
          "description": "The most judge calls to this model's provider at once, across the run.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "model": {
          "description": "`'provider/model'`, or a fake judge with a numeric score.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "\\/"
            },
            {
              "$ref": "#/$defs/FakeJudgeData"
            }
          ]
        },
        "on": {
          "description": "What to grade instead of the latest turn: an earlier turn, or a value.",
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "turn": {
                  "description": "The turn's index, from 0.",
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": ["turn"],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "value": {
                  "description": "Graded as the output.",
                  "$ref": "#/$defs/JSONValue"
                }
              },
              "required": ["value"],
              "additionalProperties": false
            }
          ]
        },
        "providerOptions": {
          "description": "AI SDK provider options for the judge's calls, keyed by provider.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/JSONValue"
            }
          }
        },
        "state": {
          "description": "The judge's state: what the judge is given beside the question, not the workspace's or the attempt's state. Merged key by key down the cascade.",
          "$ref": "#/$defs/JudgeStateOptions"
        },
        "threshold": {
          "description": "Minimum score (0–1) for a `pass` verdict.",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "JudgeStateOptions": {
      "description": "What the judge is given: each key is a key of the state in `judge-input.json`. An unset key keeps its default, which is what the judge gets with no `state` option at all.",
      "type": "object",
      "properties": {
        "checks": {
          "description": "`c.exec` results so far; a list shows only those commands, as passed to `c.exec`. Default false.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          ]
        },
        "contents": {
          "description": "Workspace files shown whole, as they are now, changed or not: exact paths or gitignore-style patterns (`'**'`, `'src/**'`; the last match wins, `!` excludes) over the files git sees in the workspace. A missing exact path is `null`; a pattern that matches nothing adds nothing. These files leave the diff. Default none.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "diff": {
          "description": "The diff since the eval started. A list is gitignore-style patterns over workspace paths: the last matching pattern wins and `!` excludes. Default true.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          ]
        },
        "files": {
          "description": "`status path` lines for the changed files, under `diff`'s patterns. Default true.",
          "type": "boolean"
        },
        "output": {
          "description": "The graded turn's final message, or `on`'s value. Default true.",
          "type": "boolean"
        },
        "task": {
          "description": "The graded turn's prompt. Default true.",
          "type": "boolean"
        },
        "transcript": {
          "description": "The graded turn's transcript as text lines: `true` is messages and tool calls with tool output clipped, `'tools'` tool calls only, `'full'` adds reasoning and whole tool output. Default false.",
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "enum": ["tools", "full"]
            }
          ]
        },
        "turns": {
          "description": "`'all'`: every turn up to the graded one under `turns`, each with its task, output and (with `transcript`) transcript. Default `'last'`.",
          "type": "string",
          "enum": ["last", "all"]
        }
      },
      "additionalProperties": false
    },
    "MatcherArg": {
      "description": "One argument to a matcher: a JSON value, a regular expression as `{ regexp, flags? }`, or a pattern in the runner's own language as `{ matchedBy, answers }`.",
      "anyOf": [
        {
          "$ref": "#/$defs/Pattern"
        },
        {
          "$ref": "#/$defs/AnsweredPattern"
        },
        {
          "$ref": "#/$defs/JSONValue"
        }
      ]
    },
    "MatcherSubject": {
      "description": "What `expect` was given: a turn `c.send` returned, the attempt (for its files and latest turn), a value, such as an `ExecResult`, or a command or file reeval reads for it.",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "turn": {
              "description": "The turn's index, from 0.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["turn"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "attempt": {
              "description": "The attempt itself, `c`.",
              "type": "boolean",
              "const": true
            }
          },
          "required": ["attempt"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "value": {
              "description": "A value the eval passes as it is.",
              "$ref": "#/$defs/JSONValue"
            }
          },
          "required": ["value"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "exec": {
              "description": "A command reeval runs, for its `ExecResult`; again on each try when polled.",
              "type": "string",
              "pattern": "\\S"
            },
            "result": {
              "description": "The command's `ExecResult` when the runner already ran it: reeval checks that instead of running it again, and the check is still named by the command.",
              "$ref": "#/$defs/ExecResult"
            }
          },
          "required": ["exec"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "readFile": {
              "description": "A file reeval reads, for its contents (null when there's none).",
              "type": "string",
              "pattern": "\\S"
            }
          },
          "required": ["readFile"],
          "additionalProperties": false
        }
      ]
    },
    "Pattern": {
      "description": "A regular expression, where a matcher takes a string or a `RegExp`.",
      "type": "object",
      "properties": {
        "flags": {
          "description": "Its flags, e.g. `i`.",
          "type": "string",
          "pattern": "^[dgimsuvy]*$"
        },
        "regexp": {
          "description": "The pattern's source, as `RegExp.prototype.source` gives it.",
          "type": "string"
        }
      },
      "required": ["regexp"],
      "additionalProperties": false
    },
    "Wait": {
      "description": "Same shape at top-level `wait` and `{ wait }` between instructions.",
      "anyOf": [
        {
          "$ref": "#/$defs/CaptureWait"
        },
        {
          "type": "object",
          "properties": {
            "ms": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": ["ms"],
          "additionalProperties": false
        }
      ]
    }
  }
}
