{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from AnalysisDoc in src/view/analysis.ts by `pnpm schema:update`; don't edit. A reeval analyze document, or analysis.agent's run summary: <run>/analysis/*.json and .reeval/analysis/<key>.json.",
  "title": "AnalysisDoc",
  "$ref": "#/$defs/AnalysisDoc",
  "$defs": {
    "ActionKind": {
      "enum": ["docs", "es", "eval", "harness", "judge", "skill"]
    },
    "AnalysisAction": {
      "type": "object",
      "properties": {
        "change": {
          "type": "string"
        },
        "cites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effort": {
          "$ref": "#/$defs/Level"
        },
        "expectedEffect": {
          "type": "string"
        },
        "impact": {
          "$ref": "#/$defs/Level"
        },
        "kind": {
          "$ref": "#/$defs/ActionKind"
        },
        "target": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "verify": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "verifyProblem": {
          "type": "string"
        }
      },
      "required": [
        "change",
        "cites",
        "effort",
        "expectedEffect",
        "impact",
        "kind",
        "target",
        "title",
        "verify"
      ]
    },
    "AnalysisAnomaly": {
      "type": "object",
      "properties": {
        "cites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "$ref": "#/$defs/AnomalyKind"
        },
        "text": {
          "type": "string"
        },
        "unverifiedNumbers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["cites", "kind", "text"]
    },
    "AnalysisBody": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnalysisAction"
          }
        },
        "anomalies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnalysisAnomaly"
          }
        },
        "confidence": {
          "type": "object",
          "properties": {
            "overall": {
              "$ref": "#/$defs/Confidence"
            },
            "why": {
              "type": "string"
            }
          },
          "required": ["overall", "why"]
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnalysisClaim"
          }
        },
        "tldr": {
          "type": "string"
        },
        "whatHappened": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnalysisClaim"
          }
        },
        "why": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnalysisClaim"
          }
        }
      },
      "required": ["actions", "anomalies", "confidence", "results", "tldr", "whatHappened", "why"]
    },
    "AnalysisClaim": {
      "type": "object",
      "properties": {
        "cites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "quotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "text": {
          "type": "string"
        },
        "unverifiedNumbers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["cites", "confidence", "text"]
    },
    "AnalysisDoc": {
      "type": "object",
      "properties": {
        "analysis": {
          "$ref": "#/$defs/AnalysisBody"
        },
        "anchor": {
          "type": "string"
        },
        "attempts": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": {
            "type": "object",
            "properties": {
              "attempt": {
                "type": "string"
              },
              "evalSlug": {
                "type": "string"
              },
              "runId": {
                "type": "string"
              }
            },
            "required": ["attempt", "evalSlug", "runId"]
          }
        },
        "author": {
          "type": "string"
        },
        "cited": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "inputs": {
          "type": "object",
          "properties": {
            "digestHash": {
              "type": "string"
            },
            "digestVersion": {
              "type": "number"
            },
            "records": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "runId": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string"
                  }
                },
                "required": ["runId", "sha256"]
              }
            }
          },
          "required": ["digestHash", "digestVersion", "records"]
        },
        "kind": {
          "const": "es-analysis"
        },
        "latencyMs": {
          "type": "number"
        },
        "model": {
          "type": "string"
        },
        "promptVersion": {
          "type": "string"
        },
        "resolvedModel": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "route": {
          "enum": ["direct", "fake", "gateway"]
        },
        "schemaVersion": {
          "const": 1
        },
        "scope": {
          "$ref": "#/$defs/AnalysisScope"
        },
        "usage": {
          "type": "object",
          "properties": {
            "inputTokens": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "outputTokens": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "required": ["inputTokens", "outputTokens"]
        },
        "validation": {
          "$ref": "#/$defs/AnalysisValidation"
        }
      },
      "required": [
        "analysis",
        "anchor",
        "attempts",
        "author",
        "cited",
        "createdAt",
        "inputs",
        "kind",
        "latencyMs",
        "model",
        "promptVersion",
        "resolvedModel",
        "route",
        "schemaVersion",
        "scope",
        "usage",
        "validation"
      ]
    },
    "AnalysisScope": {
      "type": "object",
      "properties": {
        "base": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "evals": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "head": {
          "type": "string"
        },
        "kind": {
          "const": "run"
        }
      },
      "required": ["base", "evals", "head", "kind"]
    },
    "AnalysisValidation": {
      "type": "object",
      "properties": {
        "citations": {
          "type": "number"
        },
        "commands": {
          "type": "number"
        },
        "dropped": {
          "type": "number"
        },
        "invalid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "invalidCommands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unverifiedNumbers": {
          "type": "number"
        }
      },
      "required": [
        "citations",
        "commands",
        "dropped",
        "invalid",
        "invalidCommands",
        "unverifiedNumbers"
      ]
    },
    "AnomalyKind": {
      "enum": ["es-bug", "eval-design", "judge", "noise", "other"]
    },
    "Confidence": {
      "enum": ["high", "low", "medium"]
    },
    "Level": {
      "enum": ["high", "low", "medium"]
    }
  },
  "x-schemaVersion": 1
}
