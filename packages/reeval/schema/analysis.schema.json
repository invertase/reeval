{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from AnalysisDoc's Zod schemas, held to its type in src/view/analysis.ts by `pnpm schema:update`; don't edit. A reeval analyze document: <run>/analysis/*.json and .reeval/analysis/<key>.json.",
  "title": "AnalysisDoc",
  "$ref": "#/$defs/AnalysisDoc",
  "$defs": {
    "ActionKind": {
      "type": "string",
      "enum": ["skill", "docs", "eval", "judge", "reeval", "harness"]
    },
    "AnalysisAction": {
      "type": "object",
      "properties": {
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "attemptId": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": ["attemptId", "path"]
          }
        },
        "change": {
          "type": "string"
        },
        "cites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effort": {
          "$ref": "#/$defs/Level"
        },
        "evalId": {
          "type": "string"
        },
        "expectedEffect": {
          "type": "string"
        },
        "impact": {
          "$ref": "#/$defs/Level"
        },
        "kind": {
          "$ref": "#/$defs/ActionKind"
        },
        "role": {
          "type": "string",
          "enum": ["finding", "caveat", "action"]
        },
        "target": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "verify": {
          "description": "An `reeval` command that shows the effect; null when the model's didn't parse as reeval's CLI.",
          "type": ["string", "null"]
        },
        "verifyProblem": {
          "description": "Why the model's verify command was rejected.",
          "type": "string"
        }
      },
      "required": [
        "change",
        "cites",
        "effort",
        "expectedEffect",
        "impact",
        "kind",
        "target",
        "title",
        "verify"
      ]
    },
    "AnalysisAnomaly": {
      "type": "object",
      "properties": {
        "attempts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "attemptId": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": ["attemptId", "path"]
          }
        },
        "cites": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evalId": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AnomalyKind"
        },
        "role": {
          "type": "string",
          "enum": ["finding", "caveat", "action"]
        },
        "text": {
          "type": "string"
        },
        "unverifiedNumbers": {
          "description": "Numbers in the text that no cited fact or evidence contains.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["cites", "kind", "text"]
    },
    "AnalysisBody": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnalysisAction"
          }
        },
        "anomalies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnalysisAnomaly"
          }
        },
        "confidence": {
          "type": "object",
          "properties": {
            "overall": {
              "$ref": "#/$defs/Confidence"
            },
            "why": {
              "type": "string"
            }
          },
          "required": ["overall", "why"]
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnalysisClaim"
          }
        },
        "tldr": {
          "type": "string"
        },
        "whatHappened": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnalysisClaim"
          }
        },
        "why": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AnalysisClaim"
          }
        }
      },
      "required": ["actions", "anomalies", "confidence", "results", "tldr", "whatHappened", "why"]
    },
    "AnalysisClaim": {
      "type": "object",
      "properties": {
        "attempts": {
          "description": "Attempt cites resolved to ids and paths; optional on older docs.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "attemptId": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            },
            "required": ["attemptId", "path"]
          }
        },
        "cites": {
          "description": "Fact (`F3`), evidence (`E2`, `E2:L39`), attempt (`r2/scaffold/reeval-good#1`) or check ids.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "evalId": {
          "description": "Eval id this claim is about, when resolved from attempt cites; optional on older docs.",
          "type": "string"
        },
        "quotes": {
          "description": "Exact spans from the cited evidence; a claim whose quote isn't there is dropped.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "role": {
          "description": "Section role; optional on older docs (derived from which body array it sits in).",
          "type": "string",
          "enum": ["finding", "caveat", "action"]
        },
        "text": {
          "type": "string"
        },
        "unverifiedNumbers": {
          "description": "Numbers in the text that no cited fact or evidence contains.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["cites", "confidence", "text"]
    },
    "AnalysisDoc": {
      "type": "object",
      "properties": {
        "analysis": {
          "$ref": "#/$defs/AnalysisBody"
        },
        "anchor": {
          "description": "The run the analysis belongs to: the scope's head.",
          "type": "string"
        },
        "attempts": {
          "description": "Short attempt ids used in citations, and where each attempt is.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "attempt": {
                "type": "string"
              },
              "evalSlug": {
                "type": "string"
              },
              "runId": {
                "type": "string"
              }
            },
            "required": ["attempt", "evalSlug", "runId"]
          }
        },
        "author": {
          "type": "string"
        },
        "cited": {
          "description": "Each cited fact or evidence id, summarized in one line.",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string"
        },
        "error": {
          "description": "Why the analysis failed; its `analysis` is then empty. `reeval analyze` treats a cached one as a miss and calls the model again.",
          "type": "string"
        },
        "inputs": {
          "type": "object",
          "properties": {
            "digestHash": {
              "type": "string"
            },
            "digestVersion": {
              "type": "number"
            },
            "records": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "runId": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string"
                  }
                },
                "required": ["runId", "sha256"]
              }
            }
          },
          "required": ["digestHash", "digestVersion", "records"]
        },
        "kind": {
          "type": "string",
          "const": "reeval-analysis"
        },
        "latencyMs": {
          "type": "number"
        },
        "model": {
          "type": "string"
        },
        "promptVersion": {
          "type": "string"
        },
        "resolvedModel": {
          "type": ["string", "null"]
        },
        "route": {
          "type": "string",
          "enum": ["direct", "gateway", "openrouter", "vertex", "fake"]
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "scope": {
          "$ref": "#/$defs/AnalysisScope"
        },
        "usage": {
          "type": "object",
          "properties": {
            "inputTokens": {
              "type": ["number", "null"]
            },
            "outputTokens": {
              "type": ["number", "null"]
            }
          },
          "required": ["inputTokens", "outputTokens"]
        },
        "validation": {
          "$ref": "#/$defs/AnalysisValidation"
        }
      },
      "required": [
        "analysis",
        "anchor",
        "attempts",
        "author",
        "cited",
        "createdAt",
        "inputs",
        "kind",
        "latencyMs",
        "model",
        "promptVersion",
        "resolvedModel",
        "route",
        "schemaVersion",
        "scope",
        "usage",
        "validation"
      ]
    },
    "AnalysisScope": {
      "type": "object",
      "properties": {
        "base": {
          "description": "Resolved once, so a nearer ancestor recorded later doesn't change what this analyzed.",
          "type": ["string", "null"]
        },
        "evals": {
          "description": "An eval filter (substring of the eval id), or null for every eval.",
          "type": ["string", "null"]
        },
        "head": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "run"
        }
      },
      "required": ["base", "evals", "head", "kind"]
    },
    "AnalysisValidation": {
      "type": "object",
      "properties": {
        "citations": {
          "description": "Citations checked, and those that named nothing in the digest.",
          "type": "number"
        },
        "commands": {
          "type": "number"
        },
        "dropped": {
          "description": "Claims, anomalies and actions dropped for a bad citation, invented quote, wrong judge score, or rejected verify.",
          "type": "number"
        },
        "invalid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "invalidCommands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unverifiedNumbers": {
          "type": "number"
        }
      },
      "required": [
        "citations",
        "commands",
        "dropped",
        "invalid",
        "invalidCommands",
        "unverifiedNumbers"
      ]
    },
    "AnomalyKind": {
      "type": "string",
      "enum": ["reeval-bug", "eval-design", "judge", "noise", "other"]
    },
    "Confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "Level": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    }
  },
  "x-schemaVersion": 1
}
