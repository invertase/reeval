{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from AnalysisNote in src/view/analysis.ts by `pnpm schema:update`; don't edit. An analysis.agent note on one eval and harness: .reeval/analysis/<run>/notes/<eval>__<harness>.json.",
  "title": "AnalysisNote",
  "$ref": "#/$defs/AnalysisNote",
  "$defs": {
    "AnalysisNote": {
      "type": "object",
      "properties": {
        "attempts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "createdAt": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "evalId": {
          "type": "string"
        },
        "harness": {
          "type": "string"
        },
        "kind": {
          "const": "reeval-analysis-note"
        },
        "model": {
          "type": "string"
        },
        "resolvedModel": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "runId": {
          "type": "string"
        },
        "schemaVersion": {
          "const": 1
        },
        "text": {
          "type": "string"
        },
        "usage": {
          "type": "object",
          "properties": {
            "inputTokens": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            },
            "outputTokens": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "required": ["inputTokens", "outputTokens"]
        }
      },
      "required": [
        "attempts",
        "createdAt",
        "evalId",
        "harness",
        "kind",
        "model",
        "resolvedModel",
        "runId",
        "schemaVersion",
        "text",
        "usage"
      ]
    }
  },
  "x-schemaVersion": 1
}
