{
  "name": "reeval",
  "version": "0.27.2",
  "description": "reeval: an eval runner for coding agents",
  "license": "Apache-2.0",
  "author": "Invertase <oss@invertase.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reeval-ai/reeval.git",
    "directory": "packages/reeval"
  },
  "homepage": "https://github.com/reeval-ai/reeval#readme",
  "bugs": {
    "url": "https://github.com/reeval-ai/reeval/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "reeval": "./dist/cli.js",
    "re": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "default": "./dist/harness.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox.d.ts",
      "default": "./dist/sandbox.js"
    },
    "./sandbox/boat": {
      "types": "./dist/sandbox/boat.d.ts",
      "default": "./dist/sandbox/boat.js"
    },
    "./sandbox/daytona": {
      "types": "./dist/sandbox/daytona.d.ts",
      "default": "./dist/sandbox/daytona.js"
    },
    "./store/local": {
      "types": "./dist/store/local.d.ts",
      "default": "./dist/store/local.js"
    },
    "./store/s3": {
      "types": "./dist/store/s3.d.ts",
      "default": "./dist/store/s3.js"
    },
    "./internal/vm": {
      "types": "./dist/internal/vm.d.ts",
      "default": "./dist/internal/vm.js"
    },
    "./internal/vm-api": {
      "types": "./dist/internal/vm-api.d.ts",
      "default": "./dist/internal/vm-api.js"
    },
    "./internal/vm-api/boat": {
      "types": "./dist/internal/vm-api/boat.d.ts",
      "default": "./dist/internal/vm-api/boat.js"
    },
    "./internal/vm-api/daytona": {
      "types": "./dist/internal/vm-api/daytona.d.ts",
      "default": "./dist/internal/vm-api/daytona.js"
    },
    "./judge": {
      "types": "./dist/judge.d.ts",
      "default": "./dist/judge.js"
    },
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "default": "./dist/gateway.js"
    },
    "./view": {
      "types": "./dist/view/index.d.ts",
      "default": "./dist/view/index.js"
    },
    "./view/report": {
      "types": "./dist/view/report/index.d.ts",
      "default": "./dist/view/report/index.js"
    },
    "./renderer/markdown": {
      "types": "./dist/renderer/markdown.d.ts",
      "default": "./dist/renderer/markdown.js"
    },
    "./renderer/ascii": {
      "types": "./dist/renderer/ascii.d.ts",
      "default": "./dist/renderer/ascii.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docker",
    "bin",
    "assets",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "preferUnplugged": true,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown --config-loader native",
    "features:matrix": "node --experimental-strip-types --no-warnings --import ./test/support/tables-only.mjs test/support/feature-matrix.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/types",
    "schema:check": "node --experimental-strip-types --no-warnings scripts/schema/check.ts",
    "schema:update": "node --experimental-strip-types --no-warnings scripts/schema/check.ts --update",
    "sdk-types": "node --experimental-strip-types --no-warnings scripts/sdk-types.ts",
    "sdk-types:check": "node --experimental-strip-types --no-warnings scripts/sdk-types.ts --check",
    "corpus:add": "node --experimental-strip-types --no-warnings scripts/corpus/add.ts",
    "output:preview": "node --experimental-strip-types --no-warnings scripts/output/preview.ts",
    "test": "node --test --test-timeout=600000 --experimental-strip-types --no-warnings test/*.test.ts",
    "test:plan": "node --test --experimental-strip-types --no-warnings test/plan.test.ts",
    "test:features": "node --test --experimental-strip-types --no-warnings test/features.test.ts",
    "test:docker": "REEVAL_FIXTURE_TIERS=docker REEVAL_TEST_REQUIRE_DOCKER=1 node --test --experimental-strip-types --no-warnings test/features.test.ts test/docker.test.ts test/docker-antigravity.test.ts test/store-minio.test.ts test/sandbox-prepare-contract.test.ts test/sandbox-provider-conformance.test.ts test/boat-images.test.ts test/contract.test.ts test/e2e-real.test.ts test/cursor-sdk-shape.test.ts",
    "test:real": "REEVAL_FIXTURE_TIERS=real REEVAL_TEST_REAL=1 node --test --experimental-strip-types --no-warnings test/features.test.ts",
    "test:contract": "REEVAL_TEST_REAL=1 REEVAL_CONTRACT_HARNESSES=${REEVAL_CONTRACT_HARNESSES:-cursor,antigravity,claude-code,opencode,opencode-anthropic,opencode-openai,goose,goose-anthropic,goose-openai,pi,pi-anthropic,pi-openai,codex,fx,grok-build} node --test --test-concurrency=1 --experimental-strip-types --no-warnings test/contract.test.ts test/e2e-real.test.ts",
    "test:replay": "node --test --experimental-strip-types --no-warnings test/replay.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.95",
    "@ai-sdk/google": "4.0.110",
    "@ai-sdk/google-vertex": "5.0.130",
    "@ai-sdk/harness": "1.0.172",
    "@ai-sdk/harness-acp": "1.0.112",
    "@ai-sdk/openai": "4.0.107",
    "@ai-sdk/provider": "4.0.35",
    "@ai-sdk/provider-utils": "5.0.73",
    "@ai-sdk/typesafe-ai": "3.0.32",
    "@balena/dockerignore": "1.0.2",
    "@bradenmacdonald/s3-lite-client": "1.0.1",
    "@hono/node-server": "2.1.6",
    "@modelcontextprotocol/server": "2.4.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-logs-otlp-http": "0.301.2",
    "@opentelemetry/exporter-logs-otlp-proto": "0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.2",
    "@opentelemetry/otlp-exporter-base": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@vitest/expect": "5.1.0",
    "@vitest/utils": "5.1.0",
    "ai": "7.0.161",
    "commander": "15.0.0",
    "get-tsconfig": "4.14.3",
    "google-auth-library": "^11.3.1",
    "hono": "4.13.17",
    "ink": "8.0.0",
    "jiti": "2.7.0",
    "p-queue": "10.0.0",
    "p-retry": "9.0.0",
    "picomatch": "4.0.7",
    "react": "19.3.1",
    "shell-quote": "1.12.0",
    "std-env": "4.3.0",
    "string-width": "8.3.0",
    "tarn": "3.1.2",
    "tinyglobby": "0.2.17",
    "ws": "8.22.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@boatdev/sdk": "^1.13.0",
    "@daytona/sdk": ">=0.231.0 <1"
  },
  "peerDependenciesMeta": {
    "@boatdev/sdk": {
      "optional": true
    },
    "@daytona/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/harness-claude-code": "1.0.176",
    "@boatdev/sdk": "1.13.0",
    "@daytona/sdk": "0.231.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@reeval/agents": "workspace:*",
    "@reeval/harness-antigravity": "workspace:0.1.17",
    "@reeval/harness-codex": "workspace:0.1.14",
    "@reeval/harness-cursor-sdk": "workspace:0.1.9",
    "@reeval/harness-fx": "workspace:0.1.14",
    "@reeval/harness-goose": "workspace:0.1.17",
    "@reeval/harness-grok-build": "workspace:0.1.13",
    "@reeval/harness-opencode": "workspace:0.2.16",
    "@reeval/harness-pi": "workspace:0.2.10",
    "@reeval/sandbox-docker": "workspace:*",
    "@reeval/vm-api": "workspace:*",
    "@types/picomatch": "4.0.3",
    "@types/react": "19.3.0",
    "ink-testing-library": "4.0.0",
    "tsdown": "0.23.7"
  }
}
