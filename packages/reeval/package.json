{
  "name": "reeval",
  "version": "0.6.1",
  "description": "reeval: an eval runner for coding agents",
  "license": "Apache-2.0",
  "author": "Invertase <oss@invertase.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invertase/reeval.git",
    "directory": "packages/reeval"
  },
  "homepage": "https://github.com/invertase/reeval/tree/main/packages/reeval#readme",
  "bugs": {
    "url": "https://github.com/invertase/reeval/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "reeval": "./dist/cli.js",
    "re": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "default": "./dist/harness.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox.d.ts",
      "default": "./dist/sandbox.js"
    },
    "./judge": {
      "types": "./dist/judge.d.ts",
      "default": "./dist/judge.js"
    },
    "./view": {
      "types": "./dist/view/index.d.ts",
      "default": "./dist/view/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docker",
    "assets",
    "THIRD_PARTY_NOTICES.md"
  ],
  "preferUnplugged": true,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown --config-loader native",
    "features:matrix": "node --experimental-strip-types --no-warnings --import ./test/support/tables-only.mjs test/support/feature-matrix.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "schema:check": "node --experimental-strip-types --no-warnings scripts/schema/check.ts",
    "schema:update": "node --experimental-strip-types --no-warnings scripts/schema/check.ts --update",
    "corpus:add": "node --experimental-strip-types --no-warnings scripts/corpus/add.ts",
    "test": "node --test --test-timeout=600000 --experimental-strip-types --no-warnings test/*.test.ts",
    "test:plan": "node --test --experimental-strip-types --no-warnings test/plan.test.ts",
    "test:features": "node --test --experimental-strip-types --no-warnings test/features.test.ts",
    "test:docker": "REEVAL_FIXTURE_TIERS=docker REEVAL_TEST_REQUIRE_DOCKER=1 node --test --experimental-strip-types --no-warnings test/features.test.ts test/docker.test.ts test/docker-antigravity.test.ts test/sandbox-prepare-contract.test.ts test/contract.test.ts test/e2e-real.test.ts test/cursor-sdk-shape.test.ts",
    "test:real": "REEVAL_FIXTURE_TIERS=real REEVAL_TEST_REAL=1 node --test --experimental-strip-types --no-warnings test/features.test.ts",
    "test:contract": "REEVAL_TEST_REAL=1 REEVAL_CONTRACT_HARNESSES=${REEVAL_CONTRACT_HARNESSES:-cursor,antigravity,claude-code,opencode,opencode-anthropic,opencode-openai,goose,pi,codex} node --test --test-concurrency=1 --experimental-strip-types --no-warnings test/contract.test.ts test/e2e-real.test.ts",
    "test:replay": "node --test --experimental-strip-types --no-warnings test/replay.test.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.87",
    "@ai-sdk/harness": "1.0.138",
    "@ai-sdk/harness-acp": "1.0.77",
    "@ai-sdk/provider-utils": "5.0.53",
    "@ai-sdk/typesafe-ai": "3.0.12",
    "@hono/node-server": "2.1.3",
    "@modelcontextprotocol/server": "2.3.0",
    "@vitest/expect": "5.0.2",
    "@vitest/utils": "5.0.2",
    "ai": "7.0.127",
    "commander": "15.0.0",
    "get-tsconfig": "4.14.3",
    "hono": "4.13.11",
    "jiti": "2.7.0",
    "picomatch": "4.0.7",
    "std-env": "4.3.0",
    "tinyglobby": "0.2.17",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/harness-claude-code": "1.0.142",
    "@modelcontextprotocol/client": "2.3.0",
    "@reeval/harness-antigravity": "workspace:0.1.2",
    "@reeval/harness-codex": "workspace:0.1.3",
    "@reeval/harness-cursor-sdk": "workspace:0.1.2",
    "@reeval/harness-goose": "workspace:0.1.1",
    "@reeval/harness-opencode": "workspace:0.2.3",
    "@reeval/harness-pi": "workspace:0.2.2",
    "@reeval/sandbox-docker": "workspace:*",
    "@types/picomatch": "4.0.3",
    "studio-web": "workspace:*",
    "tsdown": "0.23.0"
  }
}
