{
  "name": "reeval",
  "version": "0.17.0",
  "description": "reeval: an eval runner for coding agents",
  "license": "Apache-2.0",
  "author": "Invertase <oss@invertase.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invertase/reeval.git",
    "directory": "packages/reeval"
  },
  "homepage": "https://github.com/invertase/reeval#readme",
  "bugs": {
    "url": "https://github.com/invertase/reeval/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "reeval": "./dist/cli.js",
    "re": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "default": "./dist/harness.js"
    },
    "./sandbox": {
      "types": "./dist/sandbox.d.ts",
      "default": "./dist/sandbox.js"
    },
    "./judge": {
      "types": "./dist/judge.d.ts",
      "default": "./dist/judge.js"
    },
    "./gateway": {
      "types": "./dist/gateway.d.ts",
      "default": "./dist/gateway.js"
    },
    "./view": {
      "types": "./dist/view/index.d.ts",
      "default": "./dist/view/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docker",
    "bin",
    "assets",
    "skills",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "preferUnplugged": true,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown --config-loader native",
    "features:matrix": "node --experimental-strip-types --no-warnings --import ./test/support/tables-only.mjs test/support/feature-matrix.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/types",
    "schema:check": "node --experimental-strip-types --no-warnings scripts/schema/check.ts",
    "schema:update": "node --experimental-strip-types --no-warnings scripts/schema/check.ts --update",
    "sdk-types": "node --experimental-strip-types --no-warnings scripts/sdk-types.ts",
    "sdk-types:check": "node --experimental-strip-types --no-warnings scripts/sdk-types.ts --check",
    "corpus:add": "node --experimental-strip-types --no-warnings scripts/corpus/add.ts",
    "output:preview": "node --experimental-strip-types --no-warnings scripts/output/preview.ts",
    "test": "node --test --test-timeout=600000 --experimental-strip-types --no-warnings test/*.test.ts",
    "test:plan": "node --test --experimental-strip-types --no-warnings test/plan.test.ts",
    "test:features": "node --test --experimental-strip-types --no-warnings test/features.test.ts",
    "test:docker": "REEVAL_FIXTURE_TIERS=docker REEVAL_TEST_REQUIRE_DOCKER=1 node --test --experimental-strip-types --no-warnings test/features.test.ts test/docker.test.ts test/docker-antigravity.test.ts test/sandbox-prepare-contract.test.ts test/contract.test.ts test/e2e-real.test.ts test/cursor-sdk-shape.test.ts",
    "test:real": "REEVAL_FIXTURE_TIERS=real REEVAL_TEST_REAL=1 node --test --experimental-strip-types --no-warnings test/features.test.ts",
    "test:contract": "REEVAL_TEST_REAL=1 REEVAL_CONTRACT_HARNESSES=${REEVAL_CONTRACT_HARNESSES:-cursor,antigravity,claude-code,opencode,opencode-anthropic,opencode-openai,goose,pi,codex,fx,grok-build} node --test --test-concurrency=1 --experimental-strip-types --no-warnings test/contract.test.ts test/e2e-real.test.ts",
    "test:replay": "node --test --experimental-strip-types --no-warnings test/replay.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.83",
    "@ai-sdk/google": "4.0.100",
    "@ai-sdk/google-vertex": "5.0.116",
    "@ai-sdk/harness": "1.0.156",
    "@ai-sdk/harness-acp": "1.0.95",
    "@ai-sdk/openai": "4.0.97",
    "@ai-sdk/provider": "4.0.30",
    "@ai-sdk/provider-utils": "5.0.63",
    "@ai-sdk/typesafe-ai": "3.0.22",
    "@balena/dockerignore": "1.0.2",
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/server": "2.4.0",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@vitest/expect": "5.0.5",
    "@vitest/utils": "5.0.5",
    "ai": "7.0.145",
    "commander": "15.0.0",
    "get-tsconfig": "4.14.3",
    "google-auth-library": "^10.9.1",
    "hono": "4.13.13",
    "jiti": "2.7.0",
    "picomatch": "4.0.7",
    "std-env": "4.3.0",
    "tinyglobby": "0.2.17",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/harness-claude-code": "1.0.160",
    "@modelcontextprotocol/client": "2.4.0",
    "@reeval/harness-antigravity": "workspace:0.1.12",
    "@reeval/harness-codex": "workspace:0.1.9",
    "@reeval/harness-cursor-sdk": "workspace:0.1.6",
    "@reeval/harness-fx": "workspace:0.1.3",
    "@reeval/harness-goose": "workspace:0.1.8",
    "@reeval/harness-grok-build": "workspace:0.1.6",
    "@reeval/harness-opencode": "workspace:0.2.11",
    "@reeval/harness-pi": "workspace:0.2.8",
    "@reeval/sandbox-docker": "workspace:*",
    "@types/picomatch": "4.0.3",
    "studio-web": "workspace:*",
    "tsdown": "0.23.1"
  }
}
