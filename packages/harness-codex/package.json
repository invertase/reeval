{
  "name": "@reeval/harness-codex",
  "version": "0.1.6",
  "private": true,
  "description": "An AI SDK harness adapter for OpenAI's Codex CLI on an OpenAI API key, running codex exec --json in the sandbox",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "ai",
    "harness",
    "codex",
    "openai"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings test/*.test.ts"
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.148",
    "@ai-sdk/provider": "4.0.26",
    "@ai-sdk/provider-utils": "5.0.58",
    "zod": "4.6.5"
  }
}
