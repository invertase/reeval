{
  "name": "reeval-monorepo",
  "version": "0.17.1",
  "license": "Apache-2.0",
  "author": "Invertase <oss@invertase.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/invertase/reeval.git"
  },
  "homepage": "https://github.com/invertase/reeval#readme",
  "bugs": {
    "url": "https://github.com/invertase/reeval/issues"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm -r typecheck && tsc -p examples",
    "test": "pnpm build && pnpm -r --filter './packages/*' test",
    "coverage": "pnpm build && node scripts/coverage.mjs run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "knip": "knip --no-progress",
    "images": "node scripts/sandbox-images.mjs",
    "smoke:real": "bash scripts/real-smoke.sh",
    "docs:gen": "node --experimental-strip-types --no-warnings scripts/docs.mjs",
    "docs:check": "node --experimental-strip-types --no-warnings scripts/docs.mjs --check"
  },
  "devDependencies": {
    "@bcoe/v8-coverage": "1.0.2",
    "@biomejs/biome": "2.6.3",
    "@types/node": "22.20.5",
    "c8": "12.0.0",
    "knip": "6.43.0",
    "reeval": "workspace:*",
    "rollup-plugin-license": "3.7.1",
    "spdx-expression-validate": "2.0.0",
    "spdx-satisfies": "6.0.0",
    "typescript": "7.0.2"
  }
}
