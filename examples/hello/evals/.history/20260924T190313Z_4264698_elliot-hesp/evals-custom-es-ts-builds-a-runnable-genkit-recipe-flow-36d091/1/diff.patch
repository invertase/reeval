+import { genkit, z } from 'genkit';
+import { googleAI } from '@genkit-ai/google-genai';
+
+const ai = genkit({
+  plugins: [googleAI()],
+});
+
+export const RecipeSchema = z.object({
+  title: z.string().describe('A concise, descriptive recipe title'),
+  ingredients: z
+    .array(z.string())
+    .describe('Ingredient lines with quantities, e.g. "2 cups flour"'),
+  instructions: z
+    .array(z.string())
+    .describe('Ordered cooking steps; each item is one numbered instruction'),
+});
+
+export const recipeFlow = ai.defineFlow(
+  {
+    name: 'recipeFlow',
+    inputSchema: z.object({
+      mealIdea: z
+        .string()
+        .describe('A meal idea, dish name, or brief description to recipe-ize'),
+    }),
+    outputSchema: RecipeSchema,
+  },
+  async ({ mealIdea }) => {
+    const { output } = await ai.generate({
+      model: googleAI.model('gemini-2.5-flash'),
+      prompt: `Create a practical home-cook recipe for: ${mealIdea}
+
+Return:
+- title: a clear recipe name
+- ingredients: a complete shopping list with quantities
+- instructions: step-by-step directions as an ordered array (one step per item, no numbers in the strings)`,
+      output: { schema: RecipeSchema },
+    });
+
+    if (output == null) {
+      throw new Error('Model response did not match the recipe schema.');
+    }
+
+    return output;
+  },
+);
