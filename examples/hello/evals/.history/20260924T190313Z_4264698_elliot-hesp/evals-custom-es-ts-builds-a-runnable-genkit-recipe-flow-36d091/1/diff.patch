+import { recipeFlow } from './index.js';
+
+const apiKey =
+  process.env.GOOGLE_GENAI_API_KEY ??
+  process.env.GEMINI_API_KEY ??
+  process.env.GOOGLE_API_KEY;
+
+if (!apiKey) {
+  console.error(
+    'Missing API key. Set GOOGLE_GENAI_API_KEY (see .env.example) and retry.',
+  );
+  process.exit(1);
+}
+
+const mealIdea =
+  process.argv[2] ?? 'creamy garlic mushroom pasta with fresh herbs';
+
+console.log(`Generating recipe for: "${mealIdea}"\n`);
+
+const recipe = await recipeFlow({ mealIdea });
+
+console.log(`# ${recipe.title}\n`);
+console.log('## Ingredients');
+for (const ingredient of recipe.ingredients) {
+  console.log(`- ${ingredient}`);
+}
+console.log('\n## Instructions');
+recipe.instructions.forEach((step, index) => {
+  console.log(`${index + 1}. ${step}`);
+});
