{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "packages/reeval/src/contract/*.ts": ["types"],
    "packages/reeval/src/view/report/schema.ts": ["types"]
  },
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.{mjs,ts}",
        ".vale/lint.mjs",
        "reeval*.config.ts",
        "evals/*/*.{eval.ts,config.ts}",
        "evals/*/scripts/*.mjs"
      ],
      "ignore": ["evals/*/fixtures/**", "evals/*/oracle/**"],
      "ignoreBinaries": ["report", "vale"],
      "ignoreDependencies": ["jiti"]
    },
    "packages/reeval": {
      "entry": [
        "src/{index,harness,sandbox,sandbox-boat,sandbox-daytona,internal-vm,internal-vm-api,internal-vm-api-boat,internal-vm-api-daytona,store-local,store-s3,judge,testing,bin}.ts",
        "test/**/*.{ts,mjs}",
        "scripts/**/*.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.{ts,mjs}", "scripts/**/*.ts"],
      "ignore": ["test/fixtures/records/**"],
      "ignoreBinaries": ["uv", "podman", "go", "pwsh", "tart", "pgrep", "script"],
      "ignoreDependencies": ["@ai-sdk/harness-acp", "@ai-sdk/provider", "@balena/dockerignore"]
    },
    "packages/agents": {
      "entry": ["test/**/*.ts"]
    },
    "packages/api": {
      "entry": ["test/**/*.ts"]
    },
    "packages/vm-api": {
      "entry": ["test/**/*.ts"]
    },
    "packages/harness-*": {
      "entry": ["test/**/*.ts"]
    },
    "packages/harness-codex": {
      "entry": ["test/**/*.ts"],
      "ignoreDependencies": ["@ai-sdk/provider"]
    },
    "packages/harness-fx": {
      "entry": ["test/**/*.ts"],
      "ignoreDependencies": ["@ai-sdk/provider"]
    },
    "packages/harness-grok-build": {
      "entry": ["test/**/*.ts"],
      "ignoreDependencies": ["@ai-sdk/provider"]
    },
    "packages/harness-pi": {
      "entry": ["test/**/*.ts", "assets/*.mjs", "scripts/*.mjs"],
      "ignoreDependencies": ["@ai-sdk/provider"]
    },
    "packages/harness-opencode": {
      "entry": ["test/**/*.ts", "scripts/**/*.ts"],
      "ignoreDependencies": ["@ai-sdk/provider"]
    },
    "packages/sandbox-docker": {
      "entry": ["test/**/*.ts"]
    },
    "examples/with-*": {
      "entry": ["*.eval.ts", "reeval*.config.ts"],
      "ignore": ["*/**"]
    }
  },
  "ignoreFiles": ["scripts/third-party.d.mts"]
}
