{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "5b725c806c2250223bbc55a5fce3839339730a97",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "reeval",
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": true,
      "extra-files": [
        { "type": "json", "path": "packages/reeval/package.json", "jsonpath": "$.version" },
        {
          "type": "toml",
          "path": "packages/reeval-python/pyproject.toml",
          "jsonpath": "$.project.version"
        },
        {
          "type": "toml",
          "path": "packages/reeval-python/uv.lock",
          "jsonpath": "$.package[?(@.name.value=='reeval-python')].version"
        },
        { "type": "generic", "path": "packages/reeval-dart/pubspec.yaml" },
        { "type": "generic", "path": "packages/reeval-dart/lib/src/version.dart" }
      ]
    }
  }
}
